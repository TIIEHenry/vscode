rows=[];counts={};external_aliases={}
for scope in ['src','.build','node_modules','out','build']:
 entries=sorted([R/scope,*(R/scope).rglob('*')],key=lambda p:p.relative_to(R).as_posix());regular=total=0
 for path in entries:
  x=row(path,R);rows.append(x)
  if 'sha256' in x:regular+=1;total+=x['size']
  if x['type']==stat.S_IFLNK:
   target=path.resolve()
   if not target.is_relative_to(R):external_aliases.setdefault(str(target),[]).append(dict(path=str(path),metadata=meta(path)))
 counts[scope]=dict(entriesIncludingRoot=len(entries),regularFilesHashed=regular,regularBytes=total)
assert {k:v['entriesIncludingRoot'] for k,v in counts.items()}=={'src':15716,'.build':6778,'node_modules':48773,'out':15500,'build':32328}
