 wal('050-static-reservation-postcheck-complete.json',head=F['targetHead'],sourceTree=F['targetSourceTree'],ffInvocations=1,allTrackedTargetCount=len(checked),allTrackedBytesAndGitModesExact=True,trackedClean=True,exactAuthorizedUntrackedAliasCount=2,exactAuthorizedUntrackedAliases=['.build','out'],fullStatusPorcelainZHex=EXPECTED_ALIAS_STATUS.hex(),fullWorktreeClean=False,ignoredFontExact=True,retainedOut14852AndBuild122Exact=True,sharedSevenFrozen=True,legacy3238AndOldP443AndSourceHistoryExact=True,parentsAfter=[meta(x['path']) for x in F['necessaryParentMetadata']],gitLeavesAfter=[meta(x) for x in CHECK['completeAllowedGitLeafSet']],rootRenameCtimeChanges=kept['rootRenameCtimeChanges'],buildAuthorized=False,buildPerformed=False,afterAuthorized=False,afterPerformed=False,ready=False,remainingSeconds=(deadline-now()).total_seconds())
 print(json.dumps(dict(phase='STATIC_RESERVATION_DELTA_POSTCHECK_COMPLETE',head=F['targetHead'],src=F['targetSourceTree'],ffInvocations=1,trackedTargets=len(checked),trackedClean=True,exactAuthorizedUntrackedAliasCount=2,fullWorktreeClean=False,build=False,after=False,ready=False,secondsRemaining=(deadline-now()).total_seconds())),flush=True)
except BaseException as exc:
