 assert (P/name).read_bytes()==(D/(name+'.before-legacy-semantics-clarification.raw')).read_bytes()
manifest=readj(P/'input-manifest.json')
assert manifest['sourceOnlyDirectory']=='/home/clarence/.codex/tmp/lease-business-semantic-source-v1-20261028'
assert manifest['runtimeSourcePublicationCommit']==H and manifest['runtimeSourceFreezeDirectory']==str(V)
manifest.update(sourceOnlyDirectoryPurpose='Original v1 historical schema exclusion directory: this independent package ROOT must differ. It is not the actual runtime-source directory, not the v2 freeze, and receives no v2 guard generation or source credit.',sourceOnlyDirectoryIsActualRuntimeSource=False,runtimeSourceProvenanceFile='source-provenance.json')
explanation=dict(field='input-manifest.sourceOnlyDirectory',value=manifest['sourceOnlyDirectory'],purpose='Original v1 historical schema exclusion directory, not actual runtime-source origin',exactOriginalSchemaConstPreserved=True,independentPackageRoot=str(P),sourceOnlyDirectoryNotEqualActualPackageRoot=True,actualRuntimeSourcePublicationCommit=H,actualRuntimeSourceFreezeDirectory=str(V),runtimeSourceProvenanceFile='source-provenance.json',all13RuntimeGitObjectsAndBytesAndFreezeSeparatelyBound=True,legacyV1HasNoGuardV2GenerationCredit=True,noCandidateSourceOrSchemaChanged=True,sidecarDataIsNotAnExecutedToolValidationRule=True)
for name,value in [('input-manifest.json',manifest),('legacy-source-directory-field-explanation.json',explanation)]:
 p=P/name;before=p.read_bytes();raw=rawjson(value)
 p.chmod(0o644)
 with p.open('r+b') as f:
  f.seek(0);f.write(raw);f.truncate();f.flush();os.fchmod(f.fileno(),0o444);os.fsync(f.fileno())
 changes.append(dict(path=str(p),beforeBytes=len(before),beforeSha256=sha(before),afterBytes=len(raw),afterSha256=sha(raw),onlyPackageDataChanged=True))
ruling=dict(capturedAtUtc=now(),reviewer='Original Astra',disposition='C0/I0/M0',rootAdopted=True,scope='Narrow static data semantics for unchanged historical sourceOnlyDirectory const under c6 source schema; not whole-package acceptance or execution authority',attribution='Original reviewer direct FINAL after c6 Git schema/validate/binding read, root forwarded and adopted; executor paraphrased summary, not terminal raw/verbatim/original-message bytes',ruling='Preserve original v1 literal and all source/schema bytes. Explicit manifest legacy exclusion purpose; actual runtime13 individually bound to full c6 Git object paths/bytes/SHA and true v2 freeze with pinned source-provenance. Independent /sdd ROOT differs from v1 and v2. InputManifest schema allows extra properties; const is neither bypassed nor ignored.',sourceOnlyDirectoryHasNoRuntimeSourceOrV2GenerationCredit=True,sourceOnlyDirectoryPurposeOnlyDataEvidenceNotExecutedToolValidationRule=True,executionAuthorized=False,activationAuthorized=False)
xjson(P/'source-directory-semantics-ruling.json',ruling)
xjson(D/'legacy-source-directory-data-clarification.json',dict(capturedAtUtc=now(),changes=changes,ruling=ruling,candidateImports=0,candidateExecutions=0,syntaxCalls=0))
fsyncdir(P);fsyncdir(D)
print(json.dumps({'changes':changes,'sourceAndSchemaByteChanges':0,'candidateInvocations':0}))
