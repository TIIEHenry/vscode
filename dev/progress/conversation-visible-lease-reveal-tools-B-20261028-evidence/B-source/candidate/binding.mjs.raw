// Source-only successor. Runtime authorization is a separate, pinned whole-package release.
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';
import { execFileSync } from 'node:child_process';
export const scratch = path.dirname(import.meta.filename);
export const repo = '/home/clarence/Projects/Agents/vscode-WorkTrees/merge';
export const sha = b => crypto.createHash('sha256').update(b).digest('hex');
export const check = (ok, message) => { if (!ok) throw Error(message); };
export const json = p => JSON.parse(fs.readFileSync(p, 'utf8'));
export const git = (...args) => execFileSync('rtk', ['proxy', 'git', ...args], { cwd: repo, maxBuffer: 64 * 1024 * 1024 });
const equal = (a, b) => JSON.stringify(a) === JSON.stringify(b);
export function immutableInputs(manifest) {
 return manifest.sourceFiles.map(row => {
  const canonicalAbsolute = path.resolve(repo, row.sourcePath), bytes = fs.readFileSync(row.inputCopyPath);
  check(fs.realpathSync(canonicalAbsolute) === canonicalAbsolute && fs.lstatSync(row.inputCopyPath).isFile() && !fs.lstatSync(row.inputCopyPath).isSymbolicLink() && row.inputCopyMode === 0o444 && (fs.statSync(row.inputCopyPath).mode & 0o7777) === row.inputCopyMode, 'Noncanonical source/input');
  const text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(bytes);
  check(Buffer.from(text, 'utf8').equals(bytes) && bytes.length === row.sourceBytes && sha(bytes) === row.sourceSha256, 'Immutable input UTF8/bytes/hash changed');
  return { row, canonicalAbsolute, bytes, text };
 });
}

function boundReference(row, parse = true) {
 const p = row.path, bytes = fs.readFileSync(p);
 check(path.isAbsolute(p) && fs.realpathSync(p) === p && fs.lstatSync(p).isFile() && !fs.lstatSync(p).isSymbolicLink() && bytes.length === row.bytes && sha(bytes) === row.sha256, 'Fixed lineage reference changed: ' + p);
 return parse ? JSON.parse(bytes.toString('utf8')) : bytes;
}
function verifyFixtureCompatibility(manifest, profile) {
 const fixed = profile.fixtureCompatibility, old = profile.modes.old.sourceFiles.find(row => row.role === 'reveal'), current = manifest.sourceFiles.find(row => row.role === 'reveal');
 const ancestor = git('show', old.sourceRef + ':' + old.sourcePath), bytes = fs.readFileSync(current.inputCopyPath);
 check(fixed.oldRevealIdentityIsQualificationAncestor === true && ancestor.length === old.sourceBytes && sha(ancestor) === old.sourceSha256 && git('rev-parse', old.sourceRef + ':' + old.sourcePath).toString().trim() === old.sourceBlob, 'Old Reveal qualification ancestor drift');
 const title = Buffer.from("test('" + fixed.callbackTitle + "', async () => {\n"), oldLine = Buffer.from(fixed.oldLineIncludingLF), newLine = Buffer.from(fixed.newLineIncludingLF);
 const start = ancestor.indexOf(title), end = ancestor.indexOf(Buffer.from('\n\t});'), start);
 check(start >= 0 && ancestor.indexOf(title, start + 1) === -1 && end > start, 'Accepted fixture callback must be unique');
 const callback = ancestor.subarray(start, end), local = callback.indexOf(oldLine);
 check(local >= 0 && callback.indexOf(oldLine, local + 1) === -1 && callback.indexOf(newLine) === -1, 'Accepted old fixture line must be unique in callback');
 const offset = start + local;
 check(bytes.equals(Buffer.concat([ancestor.subarray(0, offset), newLine, ancestor.subarray(offset + oldLine.length)])) && ancestor.equals(Buffer.concat([bytes.subarray(0, offset), oldLine, bytes.subarray(offset + newLine.length)])), 'Reveal exact one-line/whole-file inverse failed');
}
function verifyAcceptedFailedReferences(manifest, profile) {
 const fixed = profile.acceptedFailedRecovery, lineage = manifest.baselineLineage, old = boundReference(fixed.oldQualificationReceipt);
 check(lineage.rootAcceptedOldRecoveryReceiptPath === fixed.oldQualificationReceipt.path && lineage.rootAcceptedOldRecoveryReceiptSha256 === fixed.oldQualificationReceipt.sha256 && fixed.oldQualificationReceipt.sha256 === 'a5b51b306dcccea9c890dfae652c61f8f4804f4a67b06718ce416eb9b562f13b', 'Old qualification ancestor identity changed');
 check(old.acceptedBy === '/root' && old.oldPackageId === 'vscode-conversation-visible-lease-old-business-20261028-prep3' && old.businessOldRedQualified === true && old.restorationComplete === true && old.fullGuardPassed === true && old.finalGuardFile === old.bindings.finalGuard.path && old.finalGuardSha256 === old.bindings.finalGuard.sha256 && old.finalGuardSha256 === '6601c1435fb486deb1cc8815a428a3af7141a35081f8280059f7849d3db135b7', 'Old qualified-red/full-recovery contract changed');
 boundReference(old.bindings.finalGuard, false);
 const anchor = boundReference(fixed.anchor), receipt = boundReference(anchor.receipt);
 check(fixed.anchor.sha256 === 'f29dd7cd1b4dbba234006ff4a5668a7a78766b3261d203d20a5145df0d6d696c' && anchor.receipt.sha256 === '9e3979daa89704de65141182a607d799500d43fd5cdb3828145bbac54c31e00d' && anchor.acceptedActualFailurePreserved === true && anchor.notBusinessGreen === true && anchor.noNewRuntimeAuthority === true, 'Latest root acceptance anchor changed');
 check(receipt.acceptedBy === '/root' && receipt.actualDriverExitCode === 1 && receipt.actualOfficialExitCode === -15 && receipt.permanentlyConsumedFailedPackage === fixed.failedPackageRoot && receipt.noRetry === true && receipt.compileLaneFormallyReturned === true && receipt.currentlyAuthorizedRuntimeOwner === null, 'Root accepted failed-recovery/lane-return scope changed');
 const refs = receipt.references, byHash = new Map(refs.map(row => [row.sha256, row]));
 const expected = ['789cfe6666497db9d52ae95bbbf87602c553239ca5343f7dad1e917d2e4a208f', '5ddccbadefd83d2bafb4d79f5943edee77f28dec187810807c05e3327f5e32ce', '908aba120f4f3fe553fee5c48bbf909272ea3045d6cc6b5dae3722b53f0585b0', '6dd885b1b070b9042e611c8db4e7170d6f029cbd712af57afbed3761f3a71f13'];
 check(refs.length === 4 && byHash.size === 4 && new Set(refs.map(row => row.path)).size === 4 && expected.every(hash => byHash.has(hash)), 'Incomplete/duplicate terminal references');
 const terminal = boundReference(byHash.get(expected[0])), index = boundReference(byHash.get(expected[1])), audit = boundReference(byHash.get(expected[2])), finalRef = byHash.get(expected[3]);
 boundReference(finalRef, false);
 const same = (a, z) => ['path', 'bytes', 'sha256'].every(key => a[key] === z[key]);
 check(same(terminal.handoffIndex, byHash.get(expected[1])) && same(terminal.postrunAudit, byHash.get(expected[2])) && same(index.finalGuard, finalRef), 'Actual forward references changed');
 check(index.businessPackage === fixed.failedPackageRoot && index.head === fixed.failedHead && index.sourceTree === fixed.failedSourceTree && index.driverActualExitCode === 1 && index.officialActualExitCode === -15 && equal(index.stageActualExits, [0, 0, 0, 0, 0, -15]) && index.businessNewFullQualified === false && index.qualifiedRestorationComplete === true && index.allExactOwnedQuiet === true && index.bothLocksReleasedAtActualSample === true && index.allOriginal5203AndMain65IndexSourceProtected === true, 'Actual failed-run/recovery integrity changed');
 const names = audit.checks.map(row => row.check);
 check(names.length === 9 && new Set(names).size === 9 && fixed.auditCheckNames.length === 9 && equal([...names].sort(), [...fixed.auditCheckNames].sort()) && audit.checks.every(row => row.passed === true) && audit.failedCheckCount === 0 && equal(audit.errors, []) && audit.actualDriverExitCode === 1 && audit.actualOfficialRunnerExitCode === -15 && audit.businessNewFullQualified === false, 'Nine unique passed actual audit checks required');
 check(lineage.predecessorGuardFile === finalRef.path && lineage.predecessorGuardSha256 === finalRef.sha256, 'Direct predecessor must be latest6dd; old6601 remains qualification ancestor');
 for (const name of ['failedManifest', 'failedFreshNativeBaseline', 'failedRepositoryMetadataBaseline', 'failedOriginalSeals']) boundReference(fixed[name], false);
 // Python guard.accepted_failed_predecessor is the shared strict metadata/ctime/715→6601→fresh→6dd verifier.
 // The driver requires it before stages; parent/poststream guards reuse guard.verify. Do not compare ns JSON numbers in JS.
}

export function authorize(stage) {
 const profile = json(path.join(scratch, 'business-profile.json'));
 const release = json(path.join(scratch, 'execution-release.json'));
 const manifest = json(path.join(scratch, 'input-manifest.json')), policy = json(path.join(scratch, 'policy.json'));
 check(profile.schemaVersion === 1 && profile.protocolId === 'conversation-visible-lease-business-v1' && profile.executionAuthorized === false, 'Wrong inert source contract');
 check(release.executionAuthorized === true && release.state === 'AUTHORIZED_BUSINESS_ONCE' && release.authorizedBy === '/root' && typeof release.authorizationMessage === 'string' && release.authorizationMessage.trim(), 'FAIL CLOSED: separate explicit root execution release required');
 const mode = manifest.mode, fixed = profile.modes[mode];
 check(fixed && mode === release.mode && mode === policy.mode && scratch === manifest.packageRoot && scratch === release.packageRoot && scratch === policy.packageRoot && scratch !== manifest.sourceOnlyDirectory && path.isAbsolute(scratch) && fs.realpathSync(scratch) === scratch && process.cwd() === repo, 'Wrong independent package/mode/cwd');
 check(typeof manifest.packageId === 'string' && manifest.packageId === release.packageId && manifest.packageId === policy.packageId && release.protocolId === profile.protocolId && policy.protocolId === profile.protocolId && manifest.protocolId === profile.protocolId && release.scope === fixed.scope, 'Wrong package/release scope');
 check(equal(policy.stageOrder, profile.stageOrder) && equal(release.executionStages, profile.stageOrder) && profile.stageOrder.includes(stage) && process.env.VSCODE_LEASE_DIAGNOSTIC_STAGE === stage && /^[0-9a-f]{64}$/.test(process.env.VSCODE_LEASE_DIAGNOSTIC_DRIVER_NONCE ?? '') && (process.env.VSCODE_LEASE_DIAGNOSTIC_STAGE_TOKEN ?? '').includes(':'), 'Requires exact owned driver stage');
 const names = json(path.join(scratch, 'pin-names.json'));
 check(equal(Object.keys(release.pinnedFilesSha256).sort(), [...names].sort()) && names.includes('business-profile.json') && names.includes('package-contract.schema.json'), 'Expanded/incomplete pins');
 for (const [name, digest] of Object.entries(release.pinnedFilesSha256)) check(sha(fs.readFileSync(path.join(scratch, name))) === digest, 'Unpinned preparation ' + name);
 check(manifest.repo === repo && policy.repo === repo && manifest.expectedHead === release.expectedHead && policy.expectedHead === manifest.expectedHead && /^[0-9a-f]{40}$/.test(manifest.expectedHead) && manifest.sourceTree === profile.sourceTree && release.sourceTree === profile.sourceTree && policy.sourceTree === profile.sourceTree, 'Wrong workspace HEAD/source tree');
 check(git('rev-parse', 'HEAD').toString().trim() === manifest.expectedHead && git('rev-parse', 'HEAD:src').toString().trim() === manifest.sourceTree && git('status', '--porcelain=v1').length === 0, 'Workspace HEAD/src/clean changed');
 check(manifest.sourceFiles.length === 2 && policy.sourceInputCount === 2 && policy.totalAllowedOutPaths === 2 && policy.temporaryProductionJs === 1 && policy.temporaryTestJs === 1 && policy.standaloneMapCount === 0 && equal(policy.sourcePaths, profile.sourcePaths) && equal(policy.writableOutputPaths, profile.outputPaths) && equal(policy.observationTargetPaths, profile.outputPaths) && equal(policy.emissionPhases, profile.emissionPhases), 'Expanded dual input/write scope');
 for (let i = 0; i < fixed.sourceFiles.length; i++) {
  const wanted = fixed.sourceFiles[i], row = manifest.sourceFiles[i];
  check(Object.entries(wanted).every(([key, value]) => row[key] === value) && row.inputCopyPath === path.join(scratch, 'inputs', row.sourcePath), 'Wrong per-input Git identity/copy path');
  const bytes = git('show', row.sourceRef + ':' + row.sourcePath), live = fs.readFileSync(path.join(repo, row.sourcePath));
  check(bytes.length === row.sourceBytes && sha(bytes) === row.sourceSha256 && bytes.equals(fs.readFileSync(row.inputCopyPath)) && git('rev-parse', row.sourceRef + ':' + row.sourcePath).toString().trim() === row.sourceBlob && live.equals(git('show', manifest.expectedHead + ':' + row.sourcePath)), 'Immutable input or distinct workspace source drift');
 }
 immutableInputs(manifest);
 check(equal(json(path.join(scratch, 'selection.json')), fixed.selection), 'Selection/full-title/hook buckets changed');
 for (const row of manifest.boundToolAndConfigFiles) { const bytes = fs.readFileSync(row.path); check(bytes.length === row.bytes && sha(bytes) === row.sha256, 'Tool/config changed ' + row.path); }
 const config = fs.readFileSync(path.join(repo, profile.eslintConfig.path));
 check(config.length === profile.eslintConfig.bytes && sha(config) === profile.eslintConfig.sha256, 'Fixed ESLint config changed; rebind and peer required');
 const lineage = manifest.baselineLineage;
 check(lineage?.anchorPath === profile.baselineAnchor.path && lineage.anchorSha256 === profile.baselineAnchor.sha256 && sha(fs.readFileSync(lineage.anchorPath)) === lineage.anchorSha256 && lineage.freshCapture === true && lineage.packageId === manifest.packageId && lineage.captureAfterActual715Restoration === true && lineage.noHistorical821Reuse === true && manifest.currentNativeGuardFile === path.join(scratch, 'fresh-native-baseline.json') && manifest.guardSchemaVersion === 6 && manifest.repositoryMetadataSchemaVersion === 2, 'Fresh actual715 lineage required; consumed/821 baseline forbidden');
 check(sha(fs.readFileSync(manifest.currentNativeGuardFile)) === manifest.currentNativeGuardSha256 && manifest.currentNativeGuardSha256 !== '82129aa408f7688d8a48ed78da4cd6a7c8f0b34dec0d1156409d0cbaf432c6d1' && sha(fs.readFileSync(manifest.repositoryMetadataBaselineFile)) === manifest.repositoryMetadataBaselineSha256, 'Fresh native/metadata baseline changed');
 if (mode === 'new') {
  const accepted = json(lineage.rootAcceptedOldRecoveryReceiptPath);
  verifyFixtureCompatibility(manifest, profile);
  verifyAcceptedFailedReferences(manifest, profile);
  check(sha(fs.readFileSync(lineage.rootAcceptedOldRecoveryReceiptPath)) === lineage.rootAcceptedOldRecoveryReceiptSha256 && accepted.acceptedBy === '/root' && accepted.oldPackageId !== manifest.packageId && accepted.businessOldRedQualified === true && accepted.restorationComplete === true && accepted.fullGuardPassed === true && release.newPreparationSeparatelyAuthorized === true && release.oldRecoveryReceiptSha256 === lineage.rootAcceptedOldRecoveryReceiptSha256, 'New requires independently accepted old full recovery and separate preparation/release');
 }
 return { release, manifest, policy, profile, fixed };
}
