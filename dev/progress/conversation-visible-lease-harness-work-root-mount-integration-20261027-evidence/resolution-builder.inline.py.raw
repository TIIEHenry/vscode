records=[];tails=[]
for name in paths:
 raw=(P/"canonical-default"/(name+".raw")).read_bytes();outside,blocks=parse(raw,"default");choices=[];resolved=[]
 for j,block in enumerate(blocks):
  if name in ["dev/parallel/active/sources-accept-post-read-authorization.md","dev/progress/sources-accept-post-read-authorization-checkpoint.md"]:
   resolved.append(block["ours"]+b"\n"+block["incoming"]);choices.append("whole default ours block + one LF + whole incoming block; preserve both independent histories")
  elif name=="dev/plans/INDEX.md":
   rows=block["ours"].splitlines(keepends=True);assert len(rows)==7
   first=rows[0].decode();a=first.index("| \x60accepted\x60 |")+len("| \x60accepted\x60 |")
   rows[0]=(first[:a]+" 固定4f264两新增源码经原Astra C0/I0/M0/root02ff采纳并三路接入，src3dc120；此前80dc02/5e315方案proof保持，plan accepted；只A静态，B准备/运行待另授。[证明](../progress/conversation-visible-lease-harness-work-root-mount-integration-20261027-evidence/INDEX.md)。 |\n").encode()
   resolved.append(b"".join(rows));choices.append("keep seven ours index keys and four Sources implemented/current descriptions; update only harness row for fixed source integration, retain both original complete sides in raw")
  elif j==0:
   resolved.append('summary: "固定4f264两行WorkRootMount fixture A经原Astra C0/I0/M0/root采纳并三路接入，src3dc120；只A静态，B准备/运行待授；原8033 official1与全.build FAILED/C0/I2/M0保持，业务/lease/产品不升。"\n'.encode());choices.append("current summary combines new static source integration with actual prior failure, no runtime claim")
  else:
