 sources=manifest['sourceFiles'];paths={row['outputPath'] for row in sources};fixed=profile['emissionPhases'];overrides=native_overrides or {};completed=list(qualified_completed)
 assert all(all(row.get(key)==value for key,value in wanted.items()) for row,wanted in zip(sources,profile['modes'][manifest['mode']]['sourceFiles']))
 assert len(sources)==2 and set(policy['writableOutputPaths'])==paths==set(profile['outputPaths']) and policy['temporaryProductionJs']==policy['temporaryTestJs']==1
