  tails.append(dict(path=name,incomingTail=save("independent-tails/"+name+".incoming.raw",original_tail),actualTail=save("independent-tails/"+name+".actual-after-whole-ours.raw",actual_tail),incomingLeadingLFs=len(original_tail)-len(original_tail.lstrip(b"\n")),actualLeadingLFs=len(actual_tail)-len(actual_tail.lstrip(b"\n")),wholeOursPrefixExact=True,allNonLeadingLFTailBytesExact=True))
