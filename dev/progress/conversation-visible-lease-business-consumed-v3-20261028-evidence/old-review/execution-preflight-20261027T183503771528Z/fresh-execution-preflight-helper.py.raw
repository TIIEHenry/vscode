def lock_probe():
 names=['/tmp/vscode-compile.lock','/tmp/vscode-loop-compile.lock'];fds=[];events=[];ok=False
 try:
  for name in names:
   path=Path(name);before=meta(path);s=path.lstat()
   assert stat.S_ISREG(s.st_mode) and not path.is_symlink() and path.resolve(strict=True)==path and s.st_uid==os.getuid()
   fd=os.open(name,os.O_RDWR|os.O_NOFOLLOW);fds.append((fd,name))
   at=now();mono=time.monotonic_ns()
   try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
   except BlockingIOError:
    events.append(dict(path=name,attemptAtUtc=at,attemptMonoNs=mono,acquired=False,busy=True,before=before));raise
   events.append(dict(path=name,attemptAtUtc=at,attemptMonoNs=mono,acquired=True,busy=False,before=before,device=s.st_dev,inode=s.st_ino))
  ok=True
 finally:
  for fd,name in reversed(fds):
   try:fcntl.flock(fd,fcntl.LOCK_UN)
   finally:os.close(fd)
   for event in events:
    if event['path']==name:event['releasedAtUtc']=now();event['releasedMonoNs']=time.monotonic_ns()
  value=dict(capturedAtUtc=now(),mode='LOCK_EX|LOCK_NB, acquire both then immediately release and close; no wait, no content writes, no truncation, no lock-file creation',gatePass=ok,events=events,allDescriptorsClosed=True,noLockHeldAfterProbe=True,noWindowReservationInferred=True)
  report['compileLocks']=value;save_record('compile-lock-nonblocking-probe.json',value)
