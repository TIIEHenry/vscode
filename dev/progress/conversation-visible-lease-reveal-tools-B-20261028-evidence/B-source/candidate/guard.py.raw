 assert baseline['counts']=={'src':15716,'.build':6778,'node_modules':48773}
 return {'schemaVersion':2,'tupleFields':baseline['tupleFields'],'sort':baseline['sort'],'includesEachRootAndAllDescendants':True,'counts':baseline['counts'],'tuples':tuples,'baselineSha256':sha(raw),'metadataOnlyNotWholeContentHashes':True,'originalWholeBuildProtectionPassed':False,'currentBaselineBindsKnownHistoricalBuildLogDriftWithoutRepair':True}

def verify(expected_metadata=None,native_overrides=None,allow_ctime_paths=(),restoration_scope=None,qualified_completed=(),provisional_phase=None):
