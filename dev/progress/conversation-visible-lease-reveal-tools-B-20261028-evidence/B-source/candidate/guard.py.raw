 current_native=json.loads(native_raw);assert current_native['schemaVersion']==6 and current_native['packageId']==manifest['packageId'] and current_native['outMetadata']==predecessor['outMetadata'] and current_native['sourceNativePairs']==anchor['sourceNativePairs'] and current_native['originalWholeBuildProtectionPassed'] is False
 baseline=current_native['outMetadata'];current=outmeta();expected=expected_metadata if expected_metadata is not None else baseline
 assert set(current)==set(expected)==set(baseline) and len(current)==len(baseline)
 def qualified(row):
  return row['mode'] in fixed and row['path']==fixed[row['mode']] and row['parentSinglePathAuthority'] is True and row['qualifiedParentSpawn'] is True and row['journalOwnedWriter'] is True and row['realParentGrantQualified'] is True and row['validAtAuthoritativeIntent'] is True and row['trustedIntent']['path']==row['path'] and row['trustedIntent']['phase']=='intent'
 assert all(qualified(row) and row['classification']=='completed-write' and row['trustedCompleted']['sha256']==row['expectedFreshSha256'] for row in completed)
