 if not ok:raise RuntimeError(message)
def sha(b):return hashlib.sha256(b).hexdigest()
def now():return datetime.datetime.now(datetime.timezone.utc).isoformat()
def load_json(p):return json.loads(Path(p).read_text())
def save(p,v):Path(p).write_text(json.dumps(v,ensure_ascii=False,indent=2)+'\n')
def git(*a):return subprocess.check_output(['rtk','proxy','git',*a],cwd=REPO)
def gs(*a):return git(*a).decode().strip()
def verify_fixture_compatibility(manifest,profile):
 fixed=profile['fixtureCompatibility'];old=next(row for row in profile['modes']['old']['sourceFiles'] if row['role']=='reveal');new=next(row for row in manifest['sourceFiles'] if row['role']=='reveal')
