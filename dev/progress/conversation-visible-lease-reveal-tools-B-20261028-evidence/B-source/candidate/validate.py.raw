  require(sha(raw)==lineage['rootAcceptedOldRecoveryReceiptSha256']==release['oldRecoveryReceiptSha256'] and accepted['acceptedBy']=='/root' and accepted['oldPackageId']!=manifest['packageId'] and accepted['businessOldRedQualified'] is True and accepted['restorationComplete'] is True and accepted['fullGuardPassed'] is True and release['newPreparationSeparatelyAuthorized'] is True,'New preparation/release requires root accepted old qualified full recovery')
