OLDPREFIX='dev/progress/conversation-visible-lease-business-semantic-source-20261028-evidence/'
sha=lambda b:hashlib.sha256(b).hexdigest()
now=lambda:datetime.datetime.now(datetime.timezone.utc).isoformat()
def git(*a):return subprocess.check_output(['rtk','proxy','git',*a],cwd=R)
def readj(p):return json.loads(Path(p).read_bytes())
def meta(p):
 p=Path(p);s=p.lstat()
 return dict(type=stat.S_IFMT(s.st_mode),fullMode=s.st_mode,size=s.st_size,mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns,symlinkTarget=os.readlink(p) if stat.S_ISLNK(s.st_mode) else None)
def nmeta(p):
 s=Path(p).lstat();return dict(type=stat.S_IFMT(s.st_mode),mode=stat.S_IMODE(s.st_mode),uid=s.st_uid,gid=s.st_gid,size=s.st_size,mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns)
def row(p,base=None):
 p=Path(p);x=dict(path=p.relative_to(base).as_posix() if base else str(p),**meta(p))
 if x['type']==stat.S_IFREG:x['sha256']=sha(p.read_bytes())
 return x
def rawjson(v):return (json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode()
def fsyncdir(p):
 fd=os.open(p,os.O_RDONLY|os.O_DIRECTORY);os.fsync(fd);os.close(fd)
def write(p,b,mode=0o444):
 p=Path(p);assert p.is_relative_to(P) or p.is_relative_to(D),str(p)
 p.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
 assert p.parent.resolve(strict=True)==p.parent
 with p.open('xb') as f:
  f.write(b);f.flush();os.fchmod(f.fileno(),mode);os.fsync(f.fileno())
 return {'path':str(p),'bytes':len(b),'sha256':sha(b)}
def xjson(p,v,mode=0o444):return write(p,rawjson(v),mode)
def workspace():
 assert git('rev-parse','HEAD').decode().strip()==H
 assert git('rev-parse','HEAD:src').decode().strip()==T
 assert git('branch','--show-current').decode().strip()=='loop/merge'
 assert git('status','--porcelain=v1')==b''
workspace()
changes=[]
