 title=("test('"+fixed['callbackTitle']+"', async () => {\n").encode();oldline=fixed['oldLineIncludingLF'].encode();newline=fixed['newLineIncludingLF'].encode()
 require(ancestor.count(title)==1,'Fixture callback is not unique');start=ancestor.index(title);end=ancestor.index(b'\n\t});',start);callback=ancestor[start:end]
 require(callback.count(oldline)==1 and newline not in callback,'Fixture old line is not unique within accepted callback');offset=start+callback.index(oldline)
 require(current==ancestor[:offset]+newline+ancestor[offset+len(oldline):] and current[:offset]+oldline+current[offset+len(newline):]==ancestor,'New Reveal must differ at only the accepted callback line with whole-file inverse')

