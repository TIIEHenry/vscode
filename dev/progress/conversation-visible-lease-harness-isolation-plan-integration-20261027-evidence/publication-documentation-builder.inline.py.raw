from pathlib import Path
import subprocess,json,hashlib,difflib,datetime
R=Path.cwd();P=R/"dev/progress/conversation-visible-lease-harness-isolation-plan-integration-20261027-evidence"
head="80dc02d8a98e1190dd9039c810431c3105786588";src="fa6f7fe9f339963dd9f4190f44aa17e45f6ad731"
assert subprocess.check_output(["git","rev-parse","HEAD"],text=True).strip()==head
