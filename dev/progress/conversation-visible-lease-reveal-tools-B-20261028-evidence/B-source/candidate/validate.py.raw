 result.update(realSetupChainEstablishedByPrimaryAssertionAndFrozenControlFlow=observed and frozen_setup,expectedOldRedFailureBoundaryObserved=observed,boundaryStatement='actual primary failure supports frozen expected assertion boundary' if observed else 'expected old-red boundary not established',actualL1Outcome=l1row['actualOutcome'],actualAssertionMessage=message,completeRawStack=stack,primaryStack=primary,diagnosticSuffixCount=delimiter_count,diagnosticRawJSON=diagnostic_raw,diagnosticJSON=diagnostic,diagnosticParseError=parse_error,diagnosticParseStatus='absent-allowed' if not delimiter_count else 'parsed' if not parse_error else 'error-preserved',mappedPrimaryFrames=frames,diagnosticNestedStacksNeverMapped=True,frozenAssertionLineResolvedFromExactSource=assertion_line,frozenAssertionTextIncludingLF=assertion,inlineSourceMap=map_report,prerequisiteEvidence=evidence,reachability=reach,actualSetupPrerequisiteLocated=setup_located,businessQualificationRequiresFreshTargetsAndRecovery=True,oldFailedBodyLeakCheckClaim=False,failedBodyLeakBoundary='utils.ts skips computeLeakingDisposables for failed body; hooks/owned cleanup are recorded separately')
