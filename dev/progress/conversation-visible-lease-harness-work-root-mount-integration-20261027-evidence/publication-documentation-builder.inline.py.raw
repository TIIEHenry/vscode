for name in paths:
 b=before[name];after=(R/name).read_bytes();aa=b.decode().splitlines(keepends=True);bb=after.decode().splitlines(keepends=True);ops=[]
 for tag,a,z,c,d in difflib.SequenceMatcher(a=aa,b=bb,autojunk=False).get_opcodes():
  if tag!="equal":ops.append(dict(tag=tag,beforeStart=a,beforeEnd=z,afterStart=c,afterEnd=d,beforeLines=aa[a:z],afterLines=bb[c:d]))
 replay=aa[:]
 for e in reversed(ops):replay[e["beforeStart"]:e["beforeEnd"]]=e["afterLines"]
 assert "".join(replay).encode()==after
 edits.append(dict(path=name,beforeBytes=len(b),beforeSha256=sha(b),afterBytes=len(after),afterSha256=sha(after),lineEdits=ops,wholeReplayExact=True));patch.extend(difflib.unified_diff(aa,bb,fromfile="a/"+name,tofile="b/"+name))
