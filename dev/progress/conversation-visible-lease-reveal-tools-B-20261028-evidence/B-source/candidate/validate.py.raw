def assets_qualification(label,manifest_assets,native_overrides):
 report=load_json(ROOT/(label+'.loaded-assets.json'));by_path={row['path']:row for row in manifest_assets['files']};observed=[];seen=set();problems=[]
 inputs={row['outputPath']:row for row in load_json(ROOT/'input-manifest.json')['sourceFiles']};dry={row['outputPath']:row for row in load_json(ROOT/'dry-output-seals.json')};targets=set(inputs)
 require(set(native_overrides)==targets==set(dry),'Both independently completed fresh target outputs required')
 for actual in report['observed']:
  path=actual['path'];pinned=by_path.get(path)
  if pinned is None:problems.append('unmanifested '+path);continue
  wanted=native_overrides.get(path,pinned['sha256'])
  if actual['diskSha256']!=wanted or sha((REPO/path).read_bytes())!=wanted:problems.append('native drift '+path)
  row={**pinned,**actual,'observationStatus':'actually-loaded-parsed-script' if actual['kind']=='parsed-script' else 'actually-registered-stylesheet','currentSourceEmittedToNative':pinned['currentSourceEmittedToNative']}
  if path in targets:
   fresh=inputs[path];sealed=dry[path];emission=load_json(ROOT/('emit-'+fresh['role']+'-emitter-report.json'))
   require(len(emission['outputs'])==1 and emission['outputs'][0]['outputPath']==path and emission['outputs'][0]['sha256']==wanted==sealed['sha256'] and sealed['sourceBlob']==fresh['sourceBlob'] and sealed['sourceRef']==fresh['sourceRef'],'Target input/dry/phase lineage mismatch')
   row.update(bytes=actual['diskBytes'],sha256=wanted,historicalPinnedSourceBlob=pinned.get('currentSourceBlob'),historicalPinnedSourceSha256=pinned.get('currentSourceSha256'),producerRef=fresh['sourceRef'],producerSourceBlob=fresh['sourceBlob'],producerSourceSha256=fresh['sourceSha256'],producerQualification='same-immutable-input-plus-sealed-dry-plus-independent-phase-and-exact-loaded-runtime-bytes',currentSourceEmittedToNative=True)
   if actual['kind']!='parsed-script' or actual.get('targetRuntimeSourceEqualsDiskBytes') is not True or actual.get('targetRuntimeSourceSha256')!=wanted or actual.get('targetRuntimeSourceBytes')!=sealed['bytes'] or actual['diskBytes']!=sealed['bytes']:problems.append('target loaded fresh bytes not exact '+path)
  observed.append(row);seen.add(path)
 if not targets.issubset(seen):problems.append('missing target observations '+repr(sorted(targets-seen)))
 result=dict(label=label,requiredFreshTargets=sorted(targets),bothFreshTargetsActuallyLoaded=targets.issubset(seen) and not problems,observedAssets=observed,manifestOnlyUnobservedPaths=sorted(set(by_path)-seen),loadedUniquePathCount=len(seen),manifestOnlyCount=len(set(by_path)-seen),observerErrors=report['observerErrors'],problems=problems,unmappedRegisteredStylesheets=report['unmappedRegisteredStylesheets'],unmappedStylesheetsGrantedNativeProducerCredit=False,qualification=not problems and not report['observerErrors'],loadedDoesNotMeanFunctionCoverageOrUiAfter=True,fullCompileOfFinalSourceTree=False)
 save(ROOT/(label+'.native-provenance.json'),result);return result

def restoration_scope_audit(phases,seals):
    """Independent real-parent grant/WAL + qualified spawn + trusted journal audit.
    ACK is never a restoration condition. Valid intent survives subsequent expiry/revocation.
    """
    fixed={seal['emissionPhase']:seal['path'] for seal in seals if seal['potentialWriteEligibility']};require(set(fixed)=={'emit-pane','emit-reveal'} and len(set(fixed.values()))==2,'Wrong independent recovery phase map')
    completed=[];uncertain=[];not_admitted=[];failures=[];journals=[];restorable=set()
    def problem(mode,code,detail):failures.append(dict(mode=mode,code=code,detail=detail))
    for journal in ROOT.glob('*-out-write-journal.jsonl'):
        if journal.name not in {mode+'-out-write-journal.jsonl' for mode in fixed}:problem(None,'unscoped-journal',str(journal))
    for mode,path in fixed.items():
        rows=[phase for phase in phases if type(phase) is dict and phase.get('mode')==mode];journal=ROOT/(mode+'-out-write-journal.jsonl')
        if len(rows)!=1:
            if rows:problem(mode,'duplicate-parent-phase',len(rows))
            if journal.exists() or journal.is_symlink():problem(mode,'journal-without-unique-parent-phase',str(journal))
            continue
        phase=rows[0];authority=phase.get('parentAuthority',{});grant=authority.get('acceptedGrant');accepted=authority.get('acceptedIntent')
        parent_ok=(phase.get('eligiblePath')==path and phase.get('journalPath')==str(journal) and phase.get('journalAbsentImmediatelyBeforeSpawn') is True and phase.get('actualSpawned') is True and phase.get('spawnEntryMatchesPhase') is True and type(phase.get('rootPid')) is int and isinstance(phase.get('rootStartTime'),str) and phase['rootStartTime'].isdigit() and type(phase.get('expectedFreshBytes')) is int and phase['expectedFreshBytes']>0 and isinstance(phase.get('expectedFreshSha256'),str) and re.fullmatch('[0-9a-f]{64}',phase['expectedFreshSha256']) is not None)
        parent_intent_ok=False;grant_value=None;intent_value=None
        try:
            require(parent_ok and type(grant) is dict and type(accepted) is dict,'No actual parent accepted grant/intent')
            grant_value=grant['grant'];intent_value=accepted['intent'];control=ROOT/('stage-'+mode)/'control'
            raw=(control/'grant.json').read_bytes();require(sha(raw)==grant['grantSha256'] and json.loads(raw)==grant_value,'Real parent grant file mismatch')
            require(grant['validAfterActualDurableCompletion'] is True and accepted['validAtAuthoritativeIntent'] is True and accepted['permitRevokedBeforeIntent'] is False,'Parent did not establish valid intent')
            require(int(grant_value['issuedMonoNs'])<=int(grant['grantDurableCompletedMonoNs'])<=int(intent_value['intentStartedMonoNs'])<=int(accepted['intentDurableCompletedMonoNs'])<int(authority['deadlineMonoNs'])==int(grant_value['deadlineMonoNs'])==int(intent_value['deadlineMonoNs']),'Parent actual durable-operation ordering/deadline failure')
            require(grant_value['grantOrder']==intent_value['consumptionOrder']==1 and grant_value['phase']==mode and grant_value['path']==path and intent_value['path']==path and intent_value['phase']=='intent' and intent_value['permitId']==grant_value['permitId'] and intent_value['permitSha256']==grant['grantSha256'] and intent_value['requestId']==grant_value['requestId'] and intent_value['requestNonce']==grant_value['requestNonce'] and intent_value['requestSha256']==grant_value['requestSha256'],'Grant/intent replay or cross-phase')
            require(grant_value['parentPid']==authority['parentPid']==intent_value['recordWriterPid'] and grant_value['parentStartTime']==authority['parentStartTime']==intent_value['recordWriterStartTime'] and intent_value['recordWriterRole']=='parent-authoritative-WAL' and intent_value['outWriterRole']=='owned-compiler-child','Parent appender is not child outWriter')
            require(intent_value['bytes']==grant_value['bytes']==phase['expectedFreshBytes'] and intent_value['sha256']==grant_value['sha256']==phase['expectedFreshSha256'],'Not exact fresh bytes')
            events=authority['events'];grants=[e for e in events if e.get('kind')=='parent-grant-valid'];intents=[e for e in events if e.get('kind')=='parent-intent-valid-once'];require(len(grants)==len(intents)==1 and grants[0]['eventOrder']<intents[0]['eventOrder'],'Missing/replayed durable real parent events')
            for event in [grants[0],intents[0]]:
                raw_event=Path(event['filePath']).read_bytes();on_disk=json.loads(raw_event);require(sha(raw_event)==event['fileSha256'] and on_disk=={k:v for k,v in event.items() if k not in ['filePath','fileSha256','actualEventDurableCompletedMonoNs']} and event['recordWriterPid']==authority['parentPid'] and event['recordWriterStartTime']==authority['parentStartTime'],'Parent authority memory versus durable record mismatch')
            require(grants[0]['grantSha256']==grant['grantSha256'] and intents[0]['intentSha256']==accepted['intentSha256'] and intents[0]['intent']==intent_value,'Parent event not same real grant/intent')
            proof=grant_value['guardEvidence'];evidence=Path(proof['evidencePath']).read_bytes();require(len(evidence)==proof['evidenceBytes'] and sha(evidence)==proof['evidenceSha256'] and proof['qualified'] is True,'Independent guard evidence mismatch')
            if authority.get('revocation'):require(int(authority['revocation']['atMonoNs'])>=int(accepted['intentDurableCompletedMonoNs']),'Permit was revoked before valid intent')
            parent_intent_ok=True
        except BaseException as error:
            if journal.exists() or grant or accepted:problem(mode,'parent-grant-intent-qualification-failure',repr(error))
        if not parent_ok or not parent_intent_ok:
            not_admitted.append(dict(mode=mode,path=path,actualSpawned=phase.get('actualSpawned'),reason='No independently qualified actual parent grant and durable valid intent plus spawn; proposal/ACK/spawn/drift never substitute',restorationAuthorized=False));continue
        if not journal.is_file() or journal.is_symlink():problem(mode,'missing-or-nonregular-journal',str(journal));continue
        try:raw=journal.read_bytes()
        except OSError as error:problem(mode,'unreadable-journal',repr(error));continue
        valid=[];local_errors=[]
        for index,line in enumerate(raw.splitlines(keepends=True)):
            if not line.endswith(b'\n'):local_errors.append(dict(line=index+1,reason='incomplete-journal-record'));break
            try:event=json.loads(line)
            except (json.JSONDecodeError,UnicodeDecodeError) as error:local_errors.append(dict(line=index+1,reason='invalid-journal-json',detail=repr(error)));break
            if type(event) is not dict:local_errors.append(dict(line=index+1,reason='nonobject-journal-record',rawDecodedEvent=event));break
            writer_pid=event.get('writerPid');writer_start=event.get('writerStartTime');writer_token=event.get('stageTokenSha256');expected_token=phase.get('stageTokenSha256')
            if not(type(writer_pid) is int and writer_pid>0 and isinstance(writer_start,str) and re.fullmatch('[0-9]+',writer_start) is not None and isinstance(writer_token,str) and re.fullmatch('[0-9a-f]{64}',writer_token) is not None and isinstance(expected_token,str) and re.fullmatch('[0-9a-f]{64}',expected_token) is not None and writer_token==expected_token):
                local_errors.append(dict(line=index+1,reason='invalid-writer-fields-or-stage-token',rawDecodedEvent=event));break
            expected_phase='intent' if index==0 else 'completed' if index==1 else None
            owned=(writer_pid,writer_start) in {(r['pid'],r['startTime']) for r in phase.get('ownedProcesses',[])}
            canonical=(expected_phase is not None and event.get('phase')==expected_phase and event.get('path')==path and type(event.get('bytes')) is int and event['bytes']==phase['expectedFreshBytes'] and event.get('sha256')==phase['expectedFreshSha256'] and owned and all(event.get(k)==grant_value[k] for k in ['writerPid','writerStartTime','stageTokenSha256','requestId']) and event.get('permitId')==grant_value['permitId'] and event.get('permitSha256')==grant['grantSha256'] and event.get('intentId')==intent_value['intentId'])
            if expected_phase=='intent':canonical=canonical and event==intent_value and sha(line)==accepted['intentSha256']
            if expected_phase=='completed':canonical=canonical and event.get('absolutePath')==str(REPO/path) and event.get('intentSha256')==accepted['intentSha256'] and event.get('recordWriterRole')=='compiler-child-completion' and event.get('recordWriterPid')==writer_pid and event.get('recordWriterStartTime')==writer_start
            if not canonical:local_errors.append(dict(line=index+1,reason='out-of-scope-or-invalid-journal-sequence',rawDecodedEvent=event));break
            valid.append(event)
        if not valid:local_errors.append(dict(reason='no-trusted-intent-record'));not_admitted.append(dict(mode=mode,path=path,reason='No trusted intent prefix; no drift-based authority',restorationAuthorized=False))
        if local_errors:problem(mode,'journal-protocol-failure',local_errors)
        journals.append(dict(mode=mode,path=str(journal),bytes=len(raw),sha256=sha(raw),trustedPrefixRecords=valid,protocolErrors=local_errors))
        if valid and valid[0]['phase']=='intent':
            row=dict(mode=mode,path=path,rootPid=phase['rootPid'],rootStartTime=phase['rootStartTime'],parentSinglePathAuthority=True,qualifiedParentSpawn=True,journalOwnedWriter=True,recordWriterIsParentAndOutWriterIsChild=True,realParentGrantQualified=True,validAtAuthoritativeIntent=True,ackNotRequiredForRestoration=True,journalSha256=sha(raw),trustedIntent=valid[0],realParentGrantSha256=grant['grantSha256'],expectedFreshBytes=phase['expectedFreshBytes'],expectedFreshSha256=phase['expectedFreshSha256'])
            if len(valid)==2 and not local_errors:row.update(classification='completed-write',trustedCompleted=valid[1]);completed.append(row)
            else:row.update(classification='partial-or-uncertain-attempt',reason='Valid durable parent intent retains eligibility after expiry/end/revocation/ACK loss; no completed write claim');uncertain.append(row)
            restorable.add(path)
    for phase in phases:
        if phase.get('mode') not in fixed:problem(phase.get('mode'),'unscoped-parent-phase',phase)
    return dict(capturedAtUtc=now(),restorablePaths=sorted(restorable),actualCompletedWrites=completed,partialOrUncertainAttempts=uncertain,notAdmittedForRestoration=not_admitted,protocolFailures=failures,journals=journals,eligibilityBasis='Actual parent grant durably precedes unique valid parent CLOCK_MONOTONIC_NS WAL intent plus PID/start/token-qualified spawn/outWriter and trusted prefix; ACK never creates or cancels recovery; never inferred from drift/proposal/self-report/spawn alone')

def main():
    global EXPECTED_HEAD
    policy,manifest,release,pins=load_binding();os.chdir(REPO);EXPECTED_HEAD=manifest['expectedHead'];profile=load_json(ROOT/'business-profile.json')
    source=next(row for row in manifest['sourceFiles'] if row['role']=='reveal');reveal=source['outputPath'];pane=next(row['outputPath'] for row in manifest['sourceFiles'] if row['role']=='pane');seals=load_json(ROOT/'sealed-originals.json')
    require(len(seals)==2 and {seal['path'] for seal in seals}==set(policy['writableOutputPaths']) and all(seal['potentialWriteEligibility'] is True and seal['restoreAuthority'] is False and policy['emissionPhases'][seal['emissionPhase']]==seal['path'] for seal in seals),'Expanded phase/seal authority')
    def identity():
        require(str(Path(sys.executable).resolve())==manifest['pythonExecutable'],'Unpinned driver Python executable')
        for name,digest in pins.items():require(sha((ROOT/name).read_bytes())==digest,'Prepared file changed '+name)
        require(gs('rev-parse','HEAD')==EXPECTED_HEAD and gs('rev-parse','HEAD:src')==EXPECTED_SRC and not gs('status','--porcelain=v1'),'Workspace HEAD/src/clean changed')
        for row in manifest['sourceFiles']:
            data=Path(row['inputCopyPath']).read_bytes();require(data==git('show',row['sourceRef']+':'+row['sourcePath']) and sha(data)==row['sourceSha256'] and len(data)==row['sourceBytes'] and data.decode('utf-8').encode('utf-8')==data and (REPO/row['sourcePath']).read_bytes()==git('show',EXPECTED_HEAD+':'+row['sourcePath']),'Independent immutable input/workspace drift')
        for row in manifest['boundToolAndConfigFiles']:
            target=Path(row['path']);data=target.read_bytes();require(sha(data)==row['sha256'] and len(data)==row['bytes'] and stat.S_IMODE(target.stat().st_mode)==row['mode'],'Tool/config changed '+row['path'])
    identity();guard_api=runpy.run_path(str(ROOT/'guard.py'),run_name='guard');authority_api=runpy.run_path(str(ROOT/'parent-authority.py'),run_name='parent_authority');selection=load_json(ROOT/'selection.json');assets=load_json(ROOT/'native-asset-manifest.json')
    require(selection==profile['modes'][manifest['mode']]['selection'] and len(selection['requiredFullTitles'])==(2 if manifest['mode']=='old' else 40),'Full selection/buckets/hook multiset changed')
    native_overrides={};qualified_completed=[];before=None;expected_metadata=None;scopes=[];nonce=secrets.token_hex(32);run_token=secrets.token_hex(32)
    r={'runId':manifest['packageId'],'protocolId':PLAN,'mode':manifest['mode'],'head':EXPECTED_HEAD,'src':EXPECTED_SRC,'inputRefs':{row['role']:row['sourceRef'] for row in manifest['sourceFiles']},'startedAtUtc':now(),'stages':[],'guards':[],'restorationComplete':False,'fullCompileOfFinalSourceTree':False,'businessOldRedQualified':False,'businessNewFullQualified':False,'officialRunnerActualExitCode':None,'diagnosticProtocolStatus':'not-started','noAutomaticRetry':True,'noAutomaticNewDispatch':True,'originalWholeBuildProtectionPassed':False,'exitCode':1,'expectedStageOrder':STAGES,'expectedNamedStageGuardCount':2*len(STAGES),'expectedPoststageProtectionCount':len(STAGES),'expectedIndependentPoststreamGuardCount':len(policy['emissionPhases'])}
    report_path=ROOT/'business-report.json';require(not report_path.exists() and not (ROOT/'execution-consumed.json').exists(),'One shot consumed/report exists')
    auxiliary_errors=[]
    def note_auxiliary(label,error):
        record={'operation':label,'error':repr(error),'traceback':''.join(traceback.format_exception(type(error),error,error.__traceback__)),'atUtc':now()}
        auxiliary_errors.append(record);r['auxiliaryFailures']=auxiliary_errors;r['stickyAuxiliaryFailure']=True;r['exitCode']=1;r['businessOldRedQualified']=False;r['businessNewFullQualified']=False;r['driverAccountedOutcomeComplete']=False
    raw_save=globals()['save']
    def save(path,value):
        try:return raw_save(path,value)
        except BaseException as error:note_auxiliary('save:'+str(path),error);raise
    def report():save(report_path,r)
    def auxiliary(label,action):
        try:return True,action()
        except BaseException as error:note_auxiliary(label,error);return False,None
    def cleanup_report():auxiliary('cleanup-report',report)
    def protocol_failure(label,error):
        r.setdefault('mandatoryFailures',[]).append({'operation':label,'error':repr(error),'traceback':''.join(traceback.format_exception(type(error),error,error.__traceback__))});r['exitCode']=1;r['businessOldRedQualified']=False;r['businessNewFullQualified']=False;r['driverAccountedOutcomeComplete']=False

    def unchanged_preparation():identity()
    def global_idle(label):
        ancestors=set();pid=os.getpid()
        while pid>0:
            ancestors.add(pid);row=read_process(pid)
            if row is None:break
            pid=row['ppid']
        patterns=['compile-client','typecheck-client','transpile-client','gulp.js','build/next/index.ts transpile','build/next/index.ts watch','watch-client','tsc --project','tsgo --project','virtual-noemit','virtual-noEmit','test/unit/electron/index.js','test/unit/node/index.js','source-checker.mjs','linter.mjs','emitter.mjs','node_modules/eslint/bin/eslint.js','build/eslint.ts']
        matches=[row for pid,row in processes().items() if pid not in ancestors and any(x in ' '.join(row['argv']) for x in patterns)]
        require(not matches,'Competing compile/test process '+repr(matches));r.setdefault('globalIdleScans',[]).append(dict(label=label,atUtc=now(),patterns=patterns,matches=matches))
    def guard(label):
        identity();value=guard_api['verify'](expected_metadata,native_overrides,qualified_completed=qualified_completed);save(ROOT/('guard-'+label+'.json'),value);r['guards'].append(dict(label=label,atUtc=now(),allExpectedMetadataExact=True,outPathCount=len(value['outMetadata']),native256AndTwoTargetsExact=True,freeze4Cache3Exact=True,history257125174And28QuietExact=True));report();return value
    def prestage(label):
        require(label in STAGES and all(s.cleanup_done and not s.scan() for s in scopes),'Expanded stage or prior owned processes not quiet');global_idle(label);guard('before-'+label)
    def run_owned(label, args, overrides=None, emitter_mode=None):
        unchanged_preparation()
        stdout, stderr = ROOT / (label + '.stdout.log'), ROOT / (label + '.stderr.log')
        require(not stdout.exists() and not stderr.exists(), 'Refuse log overwrite')
        overrides = dict(overrides or {})
        stage_root=ROOT/('stage-'+label);stage_root.mkdir(mode=0o700)
        for name in ['control','tmp','cache','config','data']:(stage_root/name).mkdir(mode=0o700)
