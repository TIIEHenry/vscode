REPO=Path('/home/clarence/Projects/Agents/vscode-WorkTrees/merge')
ROOT=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def metadata(p):
 s=Path(p).lstat();return {'type':stat.S_IFMT(s.st_mode),'mode':stat.S_IMODE(s.st_mode),'uid':s.st_uid,'gid':s.st_gid,'size':s.st_size,'mtimeNs':s.st_mtime_ns,'ctimeNs':s.st_ctime_ns}
def outmeta():
 rows={'out':metadata(REPO/'out')}
 for directory,dirs,files in os.walk(REPO/'out'):
  for name in sorted(dirs+files):
   p=Path(directory)/name;rows[str(p.relative_to(REPO))]=metadata(p)
 return dict(sorted(rows.items()))
def preserved_history(manifest):
 original=json.loads(Path(manifest['oldD8ePreservationInventory']).read_text());actual=set()
 for row in original['files']:
  p=Path(row['sourcePath']);b=p.read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256'] and stat.S_IMODE(p.stat().st_mode)==row['filesystemMode'];actual.add(str(p))
  if row['mirrored']:
   m=REPO/row['mirrorPath'];assert m.read_bytes()==b and stat.S_IMODE(m.stat().st_mode)==row['filesystemMode']
 old_root=Path(manifest['baselineFile']).parent;assert {str(p) for p in old_root.rglob('*') if p.is_file()}==actual
 f33=json.loads(Path(manifest['oldF33PreservationInventory']).read_text());fset=set()
 for row in f33['files']:
  p=Path(row['path']);b=p.read_bytes();assert len(b)==row['bytes'] and sha(b)==row['sha256'] and stat.S_IMODE(p.stat().st_mode)==row['mode'];fset.add(str(p))
 assert fset=={str(p) for base in ['prep1','prep2'] for p in Path('/tmp/vscode-conversation-visible-lease-f33-validation-20261027-'+base).rglob('*') if p.is_file()}
 owned={(p['pid'],p['startTime']) for s in json.loads(Path(manifest['oldOwnedReport']).read_text())['stages'] for p in s['ownedProcesses']};alive=[]
 for pid,start in owned:
  p=Path('/proc')/str(pid)/'stat'
  try:raw=p.read_text();fields=raw[raw.rfind(')')+2:].split()
  except FileNotFoundError:continue
  if fields[19]==start:alive.append((pid,start))
 assert len(original['files'])==257 and sum(r['mirrored'] for r in original['files'])==125 and f33['fileCount']==174 and f33['totalBytes']==28784500 and len(owned)==28 and not alive
 assert all(not Path(x).exists() for x in ['/tmp/.X11-unix/X117','/tmp/.X117-lock'])
 return {'d8eScratchFiles':257,'exactMirrors':125,'f33Files':174,'f33Bytes':28784500,'oldOwnedPidStartCount':28,'oldOwnedAlive':[],'x117PathsAbsent':True}
def preserve_fixed_inputs(manifest):
 raw=Path(manifest['immutableProtectionInventoryFile']).read_bytes();assert sha(raw)==manifest['immutableProtectionInventorySha256'];inventory=json.loads(raw)
 # The original descendants-only inventory retains its historical classification.
 assert inventory['oldFileCount']==797 and inventory['oldNonRegularCount']==215 and inventory['proofFileCounts']==[280,244,235]
 legacy_roots=inventory['roots'];legacy_rows=inventory['rows'];additional_roots=inventory['additionalRootInclusiveRoots'];additional_rows=inventory['additionalRootInclusiveRows']
 assert isinstance(legacy_roots,list) and len(legacy_roots)==8 and isinstance(legacy_rows,list) and len(legacy_rows)==2018
 assert isinstance(additional_roots,list) and isinstance(additional_rows,list)
 required_roots={'/tmp/vscode-conversation-visible-lease-work-root-mount-isolated-diagnostics-20261027-prep2':557,'/tmp/vscode-conversation-visible-lease-work-root-mount-isolated-diagnostics-20261027-prep1':385}
 if manifest['mode']=='new':required_roots.update(json.loads((ROOT/'business-profile.json').read_text())['acceptedFailedRecovery']['requiredImmutableRootInclusiveCounts'])
 assert set(required_roots).issubset(additional_roots), 'Required consumed/prep1 root-inclusive originals absent'
 all_names=legacy_roots+additional_roots
 assert all(isinstance(name,str) for name in all_names) and len(all_names)==len(set(all_names)), 'Duplicate or invalid immutable roots'
 roots=[Path(name) for name in all_names]
 blocked=[ROOT,Path(str(ROOT)+'-review').resolve()]
 for name,root in zip(all_names,roots):
  assert root.is_absolute() and str(root)==name and root.resolve(strict=True)==root and root.is_dir() and not root.is_symlink(), ('Noncanonical immutable root',name)
  assert all(not root.is_relative_to(other) and not other.is_relative_to(root) for other in blocked), ('Current package/review cannot be immutable originals',name)
 for index,root in enumerate(roots):
  assert all(not root.is_relative_to(other) and not other.is_relative_to(root) for other in roots[index+1:]), ('Overlapping immutable roots',str(root))
 legacy_paths={str(p) for root in legacy_roots for p in Path(root).rglob('*')}
 additional_pathsets={name:{str(p) for p in [Path(name),*Path(name).rglob('*')]} for name in additional_roots}
 for name,count in required_roots.items():assert len(additional_pathsets[name])==count, ('Historical root-inclusive path count drift',name)
 additional_paths={path for paths in additional_pathsets.values() for path in paths}
 rows=legacy_rows+additional_rows;row_paths=[row['path'] for row in rows]
 assert all(isinstance(path,str) for path in row_paths) and len(row_paths)==len(set(row_paths)), 'Duplicate or invalid immutable inventory rows'
 assert legacy_paths=={row['path'] for row in legacy_rows} and additional_paths=={row['path'] for row in additional_rows}, 'Missing or added immutable originals'
 assert not legacy_paths.intersection(additional_paths) and legacy_paths|additional_paths==set(row_paths), 'Combined immutable pathset drift'
 for row in rows:
  p=Path(row['path']);s=p.lstat();actual={'path':str(p),'type':stat.S_IFMT(s.st_mode),'fullMode':s.st_mode,'size':s.st_size,'mtimeNs':s.st_mtime_ns,'ctimeNs':s.st_ctime_ns,'symlinkTarget':os.readlink(p) if p.is_symlink() else None}
  if stat.S_ISREG(s.st_mode):actual['sha256']=sha(p.read_bytes())
  assert actual==row,('immutable old evidence/proof drift',str(p))
 return {'old797Files215NonregularExact':True,'committedProofFileCounts':[280,244,235],'legacyDescendantsOnlyRoots':8,'legacyRows':2018,'additionalRootInclusiveRoots':additional_roots,'additionalRootInclusiveRows':len(additional_rows),'requiredHistoricalRootInclusiveCounts':required_roots,'combinedImmutableRows':len(rows),'inventorySha256':sha(raw),'listedRegularFilesContentBoundNotWholeTreeContentClaim':True,'rootInclusiveOriginalsExact':True}


def bound_json_reference(row):
 p=Path(row['path']);assert p.is_absolute() and p.resolve(strict=True)==p and p.is_file() and not p.is_symlink()
 raw=p.read_bytes();assert len(raw)==row['bytes'] and sha(raw)==row['sha256'],('fixed lineage reference drift',str(p))
 return json.loads(raw)

def exact_ctime_transition(before,after,changes,paths):
 assert set(before)==set(after) and len(changes)==len(paths)==2 and {row['path'] for row in changes}==set(paths)
 bypath={row['path']:row for row in changes};assert len(bypath)==2
 actual_changes={name for name in before if before[name]!=after[name]};assert actual_changes==set(paths)
 for name in paths:
  a,z=before[name],after[name];row=bypath[name]
  assert set(a)==set(z) and [key for key in a if a[key]!=z[key]]==['ctimeNs'] and row['keys']==['ctimeNs']
  assert row['beforeCtimeNs']==a['ctimeNs'] and row['afterCtimeNs']==z['ctimeNs']

