def repository_metadata():
 manifest=json.loads((ROOT/'input-manifest.json').read_text());raw=Path(manifest['repositoryMetadataBaselineFile']).read_bytes()
 assert sha(raw)==manifest['repositoryMetadataBaselineSha256'];baseline=json.loads(raw)
 assert baseline['schemaVersion']==manifest['repositoryMetadataSchemaVersion']==2 and baseline['tupleFields']==['path','type','fullMode','size','mtimeNs','ctimeNs','symlinkTarget'] and baseline['includesEachRootAndAllDescendants'] is True and baseline['sort']=='lexicographic POSIX relative path string'
 tuples={}
 for scope in ['src','.build','node_modules']:
  rows=[]
  for p in sorted([REPO/scope,*(REPO/scope).rglob('*')],key=lambda p:p.relative_to(REPO).as_posix()):
   s=p.lstat();rows.append([p.relative_to(REPO).as_posix(),stat.S_IFMT(s.st_mode),s.st_mode,s.st_size,s.st_mtime_ns,s.st_ctime_ns,os.readlink(p) if p.is_symlink() else None])
  tuples[scope]=rows
