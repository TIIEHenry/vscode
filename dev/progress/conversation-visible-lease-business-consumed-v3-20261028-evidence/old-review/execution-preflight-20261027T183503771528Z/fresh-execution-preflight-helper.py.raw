def memory():
 captured=now();host={}
 for line in Path('/proc/meminfo').read_text().splitlines():
  key,value=line.split(':',1)
  if key in ['MemTotal','MemAvailable','SwapTotal','SwapFree','Shmem']:
   host[key]=int(value.strip().split()[0])*1024
 raw=Path('/proc/self/cgroup').read_text();relative=next(line.split('::',1)[1] for line in raw.splitlines() if line.startswith('0::'))
 current=Path('/sys/fs/cgroup')/relative.lstrip('/');ancestors=[];headrooms=[]
 for candidate in [current,*[p for p in current.parents if p.is_relative_to(Path('/sys/fs/cgroup'))]]:
  values={};errors={}
  for name in ['memory.max','memory.current','memory.high','memory.events','memory.swap.max','memory.swap.current','memory.swap.high']:
   q=candidate/name
   try:values[name]=q.read_text().strip()
   except OSError as error:values[name]=None;errors[name]=str(error)
  is_root=candidate==Path('/sys/fs/cgroup')
  if not is_root:assert values['memory.max'] is not None and values['memory.current'] is not None and values['memory.high'] is not None,dict(path=str(candidate),errors=errors)
  used=int(values['memory.current']) if values['memory.current'] is not None else None
  per={}
  for name in ['memory.max','memory.high']:
   limit=values[name]
   if limit is not None and limit!='max':
    available=max(0,int(limit)-used);per[name]=available;headrooms.append(available)
   else:per[name]=None
  swap_current=int(values['memory.swap.current']) if values['memory.swap.current'] is not None else None
  swap_limit=values['memory.swap.max']
  swap_headroom=max(0,int(swap_limit)-swap_current) if swap_limit is not None and swap_limit!='max' else None
  ancestors.append(dict(path=str(candidate),capturedAtUtc=now(),values=values,readErrors=errors,finiteMemoryHeadroomBytes=per,finiteSwapMaxHeadroomBytes=swap_headroom,rootControllerFilesAbsentNotClaimedAsMeasuredInfinite=is_root and values['memory.max'] is None))
 effective=min([host['MemAvailable'],*headrooms])
 return dict(capturedAtUtc=captured,completedAtUtc=now(),pid=os.getpid(),selfCgroupRaw=raw,hostBytes=host,actualProcessCgroup=str(current),visibleAncestors=ancestors,effectiveAvailableWorkingMemoryHeadroomBytes=effective,minimumRequiredWorkingHeadroomBytes=8589934592,gatePass=effective>=8589934592,swapNotCountedAsAvailableWorkingHeadroom=True,qualification='Fresh timestamped host and actual helper process cgroup/visible ancestor limits/current/high/headroom. No future runtime child observed; no memory reservation.')
def processes():
 rows=[];skipped=[];ancestors=set();pid=os.getpid()
 while pid>0:
  ancestors.add(pid)
  try:
   text=(Path('/proc')/str(pid)/'stat').read_text();fields=text[text.rfind(')')+2:].split();pid=int(fields[1])
  except OSError:break
 patterns=['compile-client','typecheck-client','transpile-client','gulp.js','build/next/index.ts transpile','build/next/index.ts watch','watch-client','tsc --project','tsgo --project','virtual-noemit','virtual-noEmit','test/unit/electron/index.js','test/unit/node/index.js','source-checker.mjs','linter.mjs','emitter.mjs','node_modules/eslint/bin/eslint.js','build/eslint.ts']
 for path in Path('/proc').iterdir():
  if not path.name.isdigit() or int(path.name) in ancestors:continue
  try:
   text=(path/'stat').read_text();fields=text[text.rfind(')')+2:].split()
   argv=[x.decode(errors='replace') for x in (path/'cmdline').read_bytes().split(b'\0') if x]
  except (OSError,IndexError,ValueError) as error:
   if isinstance(error,PermissionError):skipped.append(dict(pid=int(path.name),reason='Permission denied reading identity/cmdline; no environment read'))
   continue
  joined=' '.join(argv);matches=[pattern for pattern in patterns if pattern in joined]
  if not matches:continue
  try:exe=os.readlink(path/'exe')
  except OSError as error:exe=dict(error=str(error))
  try:cwd=os.readlink(path/'cwd')
  except OSError as error:cwd=dict(error=str(error))
  rows.append(dict(pid=int(path.name),startTime=fields[19],state=fields[0],ppid=int(fields[1]),pgrp=int(fields[2]),session=int(fields[3]),uid=path.stat().st_uid,executable=exe,cwd=cwd,argv=argv,matchedPatterns=matches))
 return dict(capturedAtUtc=now(),patterns=patterns,matches=rows,unreadableIdentityRows=skipped,excludedOwnAncestorPids=sorted(ancestors),processEnvironmentsNeverRead=True,gatePass=not rows and not skipped)
