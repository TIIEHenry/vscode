   if alias not in groups[target]['aliases']:groups[target]['aliases'].append(alias)
  continue
 root=Path(target);exists=root.exists()
 entries=sorted([root,*root.rglob('*')],key=str) if exists and root.is_dir() else [root] if exists or root.is_symlink() else []
 group=dict(target=target,aliases=aliases,exists=exists,rows=[row(p) for p in entries]);groups[target]=group
 for path in entries:
  if path.is_symlink():
   resolved=path.resolve();dest=str(resolved)
   if not resolved.is_relative_to(R) and dest!=target:
    covered=any(Path(dest).is_relative_to(Path(g)) and groups[g]['exists'] and Path(g).is_dir() for g in groups)
    if not covered:pending.setdefault(dest,[]).append(dict(path=str(path),metadata=meta(path)))
