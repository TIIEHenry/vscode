ndiff=list(difflib.ndiff(old.splitlines(keepends=True),new.splitlines(keepends=True)))
assert ''.join(difflib.restore(ndiff,1)).encode()==originals['guard.py'] and ''.join(difflib.restore(ndiff,2)).encode()==new_bytes
wr(S/'guard-forward.diff.raw',forward.encode());wr(S/'guard-inverse.diff.raw',inverse.encode())
xj(S/'guard-complete-text-replay.json',dict(scope='Complete UTF8 text diff forward/inverse replay only, never candidate execution',beforeBytes=len(originals['guard.py']),beforeSha256=sha(originals['guard.py']),afterBytes=len(new_bytes),afterSha256=sha(new_bytes),forwardDiffSha256=sha(forward.encode()),inverseDiffSha256=sha(inverse.encode()),forwardAndInverseWholeFileByteReplayExact=True,ndiff=ndiff))
