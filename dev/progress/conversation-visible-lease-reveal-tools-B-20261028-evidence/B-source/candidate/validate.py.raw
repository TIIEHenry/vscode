 require(policy['sourcePaths']==profile['sourcePaths'] and policy['writableOutputPaths']==policy['observationTargetPaths']==profile['outputPaths'] and policy['emissionPhases']==profile['emissionPhases'] and len(manifest['sourceFiles'])==2,'Wrong dual whitelist')
 for row,wanted in zip(manifest['sourceFiles'],fixed['sourceFiles']):
  require(all(row.get(key)==value for key,value in wanted.items()) and row['inputCopyPath']==str(ROOT/'inputs'/row['sourcePath']) and row['inputCopyMode']==0o444 and stat.S_IMODE(Path(row['inputCopyPath']).stat().st_mode)==row['inputCopyMode'],'Per-input identity/copy drift')
  raw=Path(row['inputCopyPath']).read_bytes();require(raw==git('show',row['sourceRef']+':'+row['sourcePath']) and raw.decode('utf-8').encode('utf-8')==raw and len(raw)==row['sourceBytes'] and sha(raw)==row['sourceSha256'] and gs('rev-parse',row['sourceRef']+':'+row['sourcePath'])==row['sourceBlob'],'Immutable UTF8/Git input drift')
 require(load_json(ROOT/'selection.json')==fixed['selection'],'Static full-title/bucket/hooks selection changed')
 names=load_json(ROOT/'pin-names.json');require(set(release['pinnedFilesSha256'])==set(names) and {'business-profile.json','package-contract.schema.json'}.issubset(names),'Expanded/incomplete pins')
 for name,digest in release['pinnedFilesSha256'].items():require(sha((ROOT/name).read_bytes())==digest,'Unpinned preparation '+name)
