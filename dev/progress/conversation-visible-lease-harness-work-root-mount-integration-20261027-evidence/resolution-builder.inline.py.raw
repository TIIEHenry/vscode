   text=text.replace("fixture真实无依赖model与emitter隔离reporter+全.build守护均须独立审查，未授权准备/重跑；","fixture两行A静态源码已peer并接入；emitter隔离及全.build阶段守护仍待B准备独审/运行另授；")
   text=text.replace("原Astra对4f264静态源码候选C0/I0/M0已由root02ff独核采纳，但未接入本次srcfa6；","原Astra固定4f264两新增源码C0/I0/M0已由root02ff独核采纳并真实三路接入，src3dc120；只A静态，不称真实setup已修好；")
   text=text.rstrip("\n")+" 本次源码接入双方首条LF/完整矩阵与旧native overlay见[源码接入证据](conversation-visible-lease-harness-work-root-mount-integration-20261027-evidence/INDEX.md)。\n"
   resolved.append(text.encode());choices.append("only current first entry combines source static peer/integration with old actual failure; both parents complete first entries with LF remain independent raw")
 target=outside[0]+b"".join(x+outside[j+1] for j,x in enumerate(resolved));ours=(P/"three-way-inputs/ours"/(name+".raw")).read_bytes()
 if name in ["dev/parallel/active/sources-accept-post-read-authorization.md","dev/progress/sources-accept-post-read-authorization-checkpoint.md"]:
