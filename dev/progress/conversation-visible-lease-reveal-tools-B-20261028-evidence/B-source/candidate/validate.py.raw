 for extension,line,column in re.findall(r'conversationSessionWindowReveal\.test\.(js|ts):(\d+):(\d+)',primary):
  value=map_frame(source_map,int(line),int(column)) if extension=='js' else dict(source=source_row['sourcePath'],line=int(line),column=int(column),origin='actual-primary-direct-TS-frame')
  frames.append(value if value is not None else dict(source=None,line=None,column=None,unmappedGeneratedLine=int(line),unmappedGeneratedColumn=int(column)))
 assertion_frame=bool(frames and isinstance(frames[0]['source'],str) and frames[0]['source'].endswith(source_row['sourcePath']) and frames[0]['line']==assertion_line==boundary['requiredPrimaryLine']==676 and frames[0]['column']==boundary['requiredPrimaryColumn']==11)
 frozen_setup=all(source_text.count(boundary[key])==1 for key in ['frozenL1BlockIncludingLF','frozenEngineHelperIncludingLF','frozenCreateEngineHarnessBlockIncludingLF'])
 require(frozen_setup,'Frozen actual real-engine setup/L1 chain changed')
