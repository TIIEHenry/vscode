from pathlib import Path
import os,json,hashlib,stat,subprocess,datetime,sys
R=Path('/home/clarence/Projects/Agents/vscode-WorkTrees/merge');N=Path('/tmp/vscode-conversation-visible-lease-work-root-mount-isolated-diagnostics-20261027-prep2');NR=Path(str(N)+'-review');O=Path('/tmp/vscode-conversation-visible-lease-work-root-mount-isolated-diagnostics-20261027-prep1')
P=Path('/home/clarence/.codex/tmp/vscode-conversation-visible-lease-old-business-20261028-prep1');PD=Path(str(P)+'-review');S=Path('/home/clarence/.codex/tmp/lease-business-semantic-source-v2-20261028');D=Path('/home/clarence/.codex/tmp/lease-business-guard-v2-publication-20261028')
sha=lambda b:hashlib.sha256(b).hexdigest()
def readj(p):return json.loads(Path(p).read_bytes())
def git(*a):return subprocess.check_output(['rtk','proxy','git',*a],cwd=R)
def meta(p):
 s=p.lstat();return dict(type=stat.S_IFMT(s.st_mode),fullMode=s.st_mode,size=s.st_size,mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns,symlinkTarget=os.readlink(p) if stat.S_ISLNK(s.st_mode) else None)
def nmeta(p):
 s=p.lstat();return dict(type=stat.S_IFMT(s.st_mode),mode=stat.S_IMODE(s.st_mode),uid=s.st_uid,gid=s.st_gid,size=s.st_size,mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns)
digests={};hashed_bytes=0
def digest(p):
 global hashed_bytes
 key=str(p)
 if key not in digests:
  b=p.read_bytes();digests[key]=sha(b);hashed_bytes+=len(b)
 return digests[key]
def row(p,base=None):
 x=dict(path=p.relative_to(base).as_posix() if base else str(p),**meta(p))
 if x['type']==stat.S_IFREG:x['sha256']=digest(p)
 return x
expected_head=sys.argv[2]
scope=git('status','--porcelain=v1','-uall').decode().splitlines()
allowed={'dev/plans/conversation-visible-lease-recovery.md','dev/progress/status.md','dev/parallel/active/sources-accept-post-read-authorization.md','dev/plans/INDEX.md','dev/progress/INDEX.md','docs/INDEX.md','docs/architecture/cross-cutting/testing.md'}
assert all(line[3:] in allowed or line[3:].startswith('dev/progress/conversation-visible-lease-business-guard-v2-20261028-evidence/') for line in scope),scope
assert git('rev-parse','HEAD').decode().strip()==expected_head and git('rev-parse','HEAD:src').decode().strip()=='3dc1205763451e60e70c1a8a84465613990aa526'
