candidate={**originals,'guard.py':new_bytes}
for name,data in candidate.items():wr(C/name,data)
forward=''.join(difflib.unified_diff(old.splitlines(keepends=True),new.splitlines(keepends=True),fromfile='fixed-dfe/guard.py',tofile='source-v2/guard.py'))
