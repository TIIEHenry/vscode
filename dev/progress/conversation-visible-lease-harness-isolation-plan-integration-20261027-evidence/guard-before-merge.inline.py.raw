import subprocess
COMMITTED_HEAD=subprocess.check_output(["git","rev-parse","HEAD"],text=True).strip()
import pathlib,json,hashlib,stat,os,datetime,subprocess
R=pathlib.Path.cwd(); E=pathlib.Path("/tmp/vscode-conversation-visible-lease-setup-diagnostics-8033-20261027-prep2")
P=pathlib.Path("/tmp/vscode-conversation-visible-lease-d8e-validation-20261027-prep1")
def sha(b):return hashlib.sha256(b).hexdigest()
def meta(p):
 s=p.lstat();return {"type":stat.S_IFMT(s.st_mode),"mode":stat.S_IMODE(s.st_mode),"uid":s.st_uid,"gid":s.st_gid,"size":s.st_size,"mtimeNs":s.st_mtime_ns,"ctimeNs":s.st_ctime_ns}
g=json.loads((E/"guard-after-restore.json").read_text()); actual={str(p.relative_to(R)):meta(p) for p in [R/"out",*(R/"out").rglob("*")]}
outProblems=[p for p in set(actual)|set(g["outMetadata"]) if actual.get(p)!=g["outMetadata"].get(p)]
pairProblems=[]
for row in g["sourceNativePairs"]:
 for path,expected,mode in [(row["sourcePath"],row["currentSourceSha256"],row["sourceMode"]),(row["nativePath"],row["nativeSha256"],row["nativeMode"])]:
  p=R/path
  if sha(p.read_bytes())!=expected or stat.S_IMODE(p.stat().st_mode)!=mode:pairProblems.append(path)
x=g["historicalAdditionalRevealIdentity"]
extra=(sha((R/x["sourcePath"]).read_bytes())=="404034f9dd15c2cf6143c44b624b0dbb398da25b27f16d962a2f01bef982388d" and sha((R/x["nativePath"]).read_bytes())==x["existingOldNativeSha256"])
freezeProblems=[n for n,v in g["freezeFiles"].items() if meta(R/n)!=v["metadata"] or sha((R/n).read_bytes())!=v["sha256"]]
cacheProblems=[n for n,v in g["cacheSymlinks"].items() if meta(R/n)!=v["metadata"] or os.readlink(R/n)!=v["target"] or str((R/n).resolve())!=v["resolved"]]
originals=json.loads((R/"dev/progress/conversation-visible-lease-d8e-old-l1-failure-20261027-evidence/source-originals-inventory.json").read_text())
originalProblems=[];mirrorProblems=[]
for row in originals["files"]:
 p=pathlib.Path(row["sourcePath"]); b=p.read_bytes()
 if len(b)!=row["bytes"] or sha(b)!=row["sha256"] or stat.S_IMODE(p.stat().st_mode)!=row["filesystemMode"]:originalProblems.append(str(p))
 if row["mirrored"]:
  q=R/row["mirrorPath"];mb=q.read_bytes()
  if b!=mb or stat.S_IMODE(q.stat().st_mode)!=row["filesystemMode"]:mirrorProblems.append(str(q))
assert {str(x) for x in P.rglob("*") if x.is_file()}=={x["sourcePath"] for x in originals["files"]}
old=json.loads((P/"prior-f33-preparations-preservation-after.json").read_text())
oldProblems=[]; oldActual=set()
for base in ["prep1","prep2"]:
 root=pathlib.Path("/tmp/vscode-conversation-visible-lease-f33-validation-20261027-"+base)
 oldActual.update(str(p) for p in root.rglob("*") if p.is_file())
for row in old["files"]:
 p=pathlib.Path(row["path"]);b=p.read_bytes()
 if len(b)!=row["bytes"] or sha(b)!=row["sha256"] or stat.S_IMODE(p.stat().st_mode)!=row["mode"]:oldProblems.append(str(p))
owned={(p["pid"],p["startTime"]) for s in json.loads((P/"validation-report.json").read_text())["stages"] for p in s["ownedProcesses"]}
alive=[]
for pid,start in owned:
 p=pathlib.Path("/proc")/str(pid)/"stat"
 if p.exists():
  raw=p.read_text(); fields=raw[raw.rfind(")")+2:].split()
  if fields[19]==start:alive.append({"pid":pid,"startTime":start})
result={"capturedAtUtc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"readOnlyInlineStdlibAndGitNoPreparedHelpers":True,"expectedHead":COMMITTED_HEAD,"actualHead":subprocess.check_output(["git","rev-parse","HEAD"],text=True).strip(),"actualSrc":subprocess.check_output(["git","rev-parse","HEAD:src"],text=True).strip(),"immutable46fcPriorAfterGuardSha256":sha((P/"guard-after-restore.json").read_bytes()),"actualOutPathCount":len(actual),"expectedOutPathCount":len(g["outMetadata"]),"outMetadataProblems":outProblems,"all15500ExactlyMatchActualPostRestoreGuard":not outProblems,"native256SourceAndNativeHashModeProblems":pairProblems,"current8033RevealSourceAndOldNativeHashExact":extra,"extraRevealHistoricalMetadata54feIsNotCurrentCtimeClaim":True,"freeze4Problems":freezeProblems,"cache3Problems":cacheProblems,"scratchOriginalFiles":len(originals["files"]),"scratchOriginalProblems":originalProblems,"all125MirrorsExact":not mirrorProblems,"mirrorProblems":mirrorProblems,"oldF33Files":old["fileCount"],"oldF33Bytes":old["totalBytes"],"oldF33PathSetExact":oldActual=={x["path"] for x in old["files"]},"oldF33Problems":oldProblems,"actualOwnedIdentityCount":len(owned),"ownedIdentitiesStillAlive":alive,"x117PathsAbsent":all(not pathlib.Path(x).exists() for x in ["/tmp/.X11-unix/X117","/tmp/.X117-lock"]),"authorizedCtimeSubset":g["authorizedCtimeDifferences"],"newRuntimeExecution":False}
assert result["actualHead"]==result["expectedHead"] and result["actualSrc"]=="fa6f7fe9f339963dd9f4190f44aa17e45f6ad731"
assert len(actual)==15500 and not any([outProblems,pairProblems,freezeProblems,cacheProblems,originalProblems,mirrorProblems,oldProblems,alive]) and extra and result["oldF33PathSetExact"] and result["x117PathsAbsent"]
result["currentSourceOverlay"]={"workingTreeSourceRef":"8033a3c23ba2b0550e817c9cc4fdebf4d12a4478","path":x["sourcePath"],"blob":"c7710eb939872d378394c7084ccf95bb50f4b4c2","bytes":len((R/x["sourcePath"]).read_bytes()),"sha256":sha((R/x["sourcePath"]).read_bytes()),"nativeProducerAndNativeBytesUnchanged":True,"old46fcSnapshotImmutableHistoricalSourceProvenance":True,"fullCompile":False}
result["currentSourceOverlay"]["topHead"]=result["actualHead"]
result["currentSourceOverlay"]["topSrc"]=result["actualSrc"]
result["currentSourceOverlay"]["sourceRef"]=result["actualHead"]
result["currentSourceOverlay"]["incomingSourceRef"]="8033a3c23ba2b0550e817c9cc4fdebf4d12a4478"

D=R/"dev/progress/conversation-visible-lease-setup-diagnostics-8033-outcome-20261027-evidence"
parents=subprocess.check_output(["git","show","-s","--format=%P",COMMITTED_HEAD],text=True).strip().split()
assert parents==["3497bdc01caa188e5ff37e8877168d50b0a398d0"]
assert subprocess.check_output(["git","show","-s","--format=%s",COMMITTED_HEAD],text=True).strip()=="docs: record lease setup diagnostics and build guard failure"
included=json.loads((D/"included-paths.json").read_bytes())["includedPaths"]
changed=[x for x in subprocess.check_output(["git","diff-tree","--no-commit-id","--name-only","-r","-z",COMMITTED_HEAD]).decode().split("\0") if x]
assert changed==included and len(changed)==286
def scope_row(name):
 p=R/name;s=p.stat();b=p.read_bytes()
 return dict(path=name,bytes=len(b),sha256=sha(b),gitBlob=hashlib.sha1(b"blob "+str(len(b)).encode()+b"\0"+b).hexdigest(),filesystemMode=stat.S_IMODE(s.st_mode),gitMode="100755" if s.st_mode&0o111 else "100644",mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns)
audit=json.loads((D/"publication-staged-audit.json").read_bytes())
assert len(audit["files"])==285
for row in audit["files"]:assert scope_row(row["path"])=={k:v for k,v in row.items() if k!="staged"}
audit_self=scope_row((D/"publication-staged-audit.json").relative_to(R).as_posix())
assert audit_self["bytes"]==169467 and audit_self["sha256"]=="30611c2073c95b77eefe16b47b31ca83c9b75d8444e77762303664b3ae53808c" and audit_self["mtimeNs"]==audit_self["ctimeNs"]==1793101693292329131
tree_entries={}
for raw in subprocess.check_output(["git","ls-tree","-r","--long","-z",COMMITTED_HEAD,"--"]+included).decode().split("\0"):
 if raw:
  header,path=raw.split("\t",1);mode,kind,obj,size=header.split();tree_entries[path]=dict(mode=mode,type=kind,blob=obj,bytes=int(size))
assert set(tree_entries)==set(included)
for name in included:
 row=scope_row(name);assert tree_entries[name]==dict(mode=row["gitMode"],type="blob",blob=row["gitBlob"],bytes=row["bytes"])
scope_bytes=sum(x["bytes"] for x in tree_entries.values());assert scope_bytes==106198053
status=subprocess.check_output(["git","status","--porcelain=v1","-uall"],text=True);assert status==""
log=(R/".build/log");s=log.stat();assert log.read_bytes()==b"[]" and s.st_mtime_ns==s.st_ctime_ns==1793100181156749660
run=json.loads((E/"diagnostic-report.json").read_bytes());owned_new={(p["pid"],p["startTime"]) for stage in run["stages"] for p in stage["ownedProcesses"]};new_alive=[]
for pid,start in owned_new:
 p=pathlib.Path("/proc")/str(pid)/"stat"
 if p.exists():
  raw=p.read_text();fields=raw[raw.rfind(")")+2:].split()
  if fields[19]==start:new_alive.append(dict(pid=pid,startTime=start))
assert not new_alive
result["currentSourceOverlay"]["sourceRef"]="3497bdc01caa188e5ff37e8877168d50b0a398d0"
result.update(phase="POST_NORMAL_SINGLE_COMMIT_READ_ONLY",commit=COMMITTED_HEAD,parentCount=1,parents=parents,tree=subprocess.check_output(["git","rev-parse",COMMITTED_HEAD+"^{tree}"],text=True).strip(),srcTree=result["actualSrc"],fixedConsumedSourceRef="3497bdc01caa188e5ff37e8877168d50b0a398d0",changedPaths=286,proofPaths=280,existingDocPaths=6,scopeBytes=scope_bytes,proofBytes=105773380,docBytes=424673,allFrozenFilesystemBytesShaModeMtimeCtimeAndCommittedBlobsExact=True,auditHistoricalFalseFieldsUnchanged=True,gitClean=True,newOwned28Quiet=True,originalRunWholeBuildProtectionPassed=False,knownBuildLogDriftUnchanged=True,noAdditionalRuntimeSourceOrToolPreparation=True,noPushOrMainSync=True)
print(json.dumps(result,ensure_ascii=False,sort_keys=True))
