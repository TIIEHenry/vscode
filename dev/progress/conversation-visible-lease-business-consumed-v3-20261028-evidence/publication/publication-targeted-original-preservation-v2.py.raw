 b=(R/x['sourcePath']).read_bytes();assert len(b)==x['currentSourceBytes'] and sha(b)==x['currentSourceSha256'] and hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()==x['currentSourceBlob'] and stat.S_IMODE((R/x['sourcePath']).stat().st_mode)==x['sourceMode'];assert digest(R/x['nativePath'])==x['nativeSha256'] and stat.S_IMODE((R/x['nativePath']).stat().st_mode)==x['nativeMode']
old=readj(N/'input-manifest.json')
for x in old['boundToolAndConfigFiles']:
 p=Path(x['path']);assert p.stat().st_size==x['bytes'] and digest(p)==x['sha256'] and stat.S_IMODE(p.stat().st_mode)==x['mode']
