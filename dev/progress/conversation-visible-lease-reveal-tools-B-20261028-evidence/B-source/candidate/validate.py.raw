            r['failedBodyLeakCheckClaim']=False;r['defaultEditorAfterIndependentlyRequired']=True
            auxiliary('final-report-after-resource-release',report)
            summary_ok,_=auxiliary('final-summary-output',lambda:print(json.dumps(dict(phase=r.get('phase'),diagnosticProtocolStatus=r['diagnosticProtocolStatus'],officialRunnerActualExitCode=r['officialRunnerActualExitCode'],driverExitCode=r['exitCode'],restorationComplete=r['restorationComplete'],businessOldRedQualified=r['businessOldRedQualified'],businessNewFullQualified=r['businessNewFullQualified'],driverAccountedOutcomeComplete=r['driverAccountedOutcomeComplete'])),flush=True))
            if not summary_ok:auxiliary('final-report-after-summary-error',report)
    return r['exitCode']
if __name__=='__main__':sys.exit(main())
