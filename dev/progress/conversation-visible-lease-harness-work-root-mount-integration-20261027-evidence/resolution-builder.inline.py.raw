    anchor=outs[j+1];end=target.find(anchor,pos) if anchor else len(target);assert end>=pos;rr.append(target[pos:end]);pos=end+len(anchor)
   assert pos==len(target)
  replay=outs[0]+b"".join(x+outs[j+1] for j,x in enumerate(rr));assert replay==target
  prefix="conflict-replays/"+style+"/"+name
  entry=dict(path=name,style=style,canonical=save(prefix+"/canonical.raw",canonical),outside=[save(prefix+f"/outside-{j:02d}.raw",x) for j,x in enumerate(outs)],blocks=[],replay=save(prefix+"/replayed.raw",replay),wholeReplayExact=True)
  for j,(block,resolution) in enumerate(zip(blks,rr)):
   entry["blocks"].append(dict(block=j+1,startLine=block["startLine"],endLine=block["endLine"],choice=choices[j] if style=="default" else "independently parsed diff3 outside anchors; whole replay exact",raw={k:save(prefix+f"/block-{j+1:02d}-{k}.raw",v) for k,v in {**{k:block[k] for k in ["full","ours","base","incoming"]},"resolution":resolution}.items() if v is not None}))
  records.append(entry)
 (R/name).write_bytes(target)
plan="dev/plans/conversation-visible-lease-harness-and-emitter-isolation.md"
assert (R/plan).read_bytes()==subprocess.check_output(["git","show",T["incoming"]+":"+plan])
result=dict(files=records,defaultBlocks=sum(len(r["blocks"]) for r in records if r["style"]=="default"),diff3Blocks=sum(len(r["blocks"]) for r in records if r["style"]=="diff3"),allEightWholeReplaysExact=True,statusLines=200,statusOnlyChangedOursLines=[7,12],sourceNoRuntimeClaim=True,planWholeIncomingExactAtMerge=True)
save("conflict-resolution-and-replay.json",(json.dumps(result,ensure_ascii=False,indent=2)+"\n").encode());save("independent-tail-lf-boundaries.json",(json.dumps(dict(files=tails),ensure_ascii=False,indent=2)+"\n").encode())
