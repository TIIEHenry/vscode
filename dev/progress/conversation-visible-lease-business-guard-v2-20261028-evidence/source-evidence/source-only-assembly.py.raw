def git(*a):return subprocess.check_output(['rtk','proxy','git',*a],cwd=R)
def wr(p,b):
 with Path(p).open('xb') as f:f.write(b);f.flush();os.fsync(f.fileno())
 Path(p).chmod(0o444)
