def sha(b):return hashlib.sha256(b).hexdigest()
def save(n,b):
 p=P/n;p.parent.mkdir(parents=True,exist_ok=True);p.write_bytes(b);return dict(path=n,bytes=len(b),sha256=sha(b))
def parse(raw,style):
 lines=raw.splitlines(keepends=True);outs=[];blocks=[];fragment=[];j=0
 begin=b"<<<<<<< HEAD\n";base_marker=("||||||| "+T["base"]+"\n").encode();end_marker=(">>>>>>> "+T["incoming"]+"\n").encode()
 while j<len(lines):
  if lines[j]!=begin:fragment.append(lines[j]);j+=1;continue
  outs.append(b"".join(fragment));fragment=[];start=j;j+=1;a=[]
  while lines[j] not in [b"=======\n",base_marker]:a.append(lines[j]);j+=1
  base=None
  if lines[j]==base_marker:
   j+=1;base=[]
   while lines[j]!=b"=======\n":base.append(lines[j]);j+=1
  j+=1;c=[]
  while lines[j]!=end_marker:c.append(lines[j]);j+=1
  j+=1;blocks.append(dict(full=b"".join(lines[start:j]),ours=b"".join(a),base=None if base is None else b"".join(base),incoming=b"".join(c),startLine=start+1,endLine=j))
 outs.append(b"".join(fragment));return outs,blocks
