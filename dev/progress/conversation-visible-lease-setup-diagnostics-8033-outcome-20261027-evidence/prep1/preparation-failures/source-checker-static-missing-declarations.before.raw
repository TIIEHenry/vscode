// Prepared only: no type checker is invoked until authorize succeeds.
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';
import { authorize, repo, scratch, check, sha } from './binding.mjs';
const { manifest } = authorize('checker');
const require = createRequire(path.join(repo, 'package.json'));
const ts = require('typescript');
const project = path.join(repo, 'src/tsconfig.json');
const read = ts.readConfigFile(project, ts.sys.readFile);
const parsed = ts.parseJsonConfigFileContent(read.config ?? {}, ts.sys, path.dirname(project), undefined, project);
const configErrors = [...(read.error ? [read.error] : []), ...parsed.errors];
const options = { ...parsed.options, noEmit: true, incremental: false, composite: false, tsBuildInfoFile: undefined };
const host = ts.createCompilerHost(options, true);
let forbiddenWriteAttempts = 0;
host.writeFile = () => { forbiddenWriteAttempts++; throw Error('FORBIDDEN: noEmit checker attempted an artifact/cache/tsbuildinfo write'); };
const program = ts.createProgram({ rootNames: parsed.fileNames, options, host, configFileParsingDiagnostics: configErrors });
const targets = manifest.sourceFiles.map(row => {
 const file = program.getSourceFile(path.resolve(repo, row.sourcePath));
 check(file && sha(Buffer.from(file.text)) === row.sourceSha256, 'Target missing/changed in complete project: ' + row.sourcePath);
 const semantic = program.getSemanticDiagnostics(file);
 return { sourcePath: row.sourcePath, sourceBlob: row.sourceBlob, syntactic: program.getSyntacticDiagnostics(file).map(format), semantic: semantic.map(format) };
});
const report = { capturedAtUtc: new Date().toISOString(), project, sourceRef: manifest.sourceRef, sourceTree: manifest.sourceTree, expectedHead: manifest.expectedHead, typescriptVersion: ts.version, originalCompilerOptions: parsed.options, effectiveCompilerOptions: options, rootCount: parsed.fileNames.length, rootNames: parsed.fileNames, programSourceFileCount: program.getSourceFiles().length, targets, configDiagnostics: config.map(format), globalDiagnostics: global.map(format), optionDiagnostics: optionDiagnostics.map(format), nonTargetSyntacticDiagnosticsRequested: false, nonTargetSemanticDiagnosticsRequested: false, filteringPolicy: 'Full actual src project and ambient context; config/options/global and single Reveal target syntactic/semantic diagnostics gate. No non-target syntactic or semantic diagnostics requested; no full-project semantic-clean claim.', noEmit: true, emitInvoked: false, incremental: false, composite: false, tsBuildInfoFile: null, forbiddenWriteAttempts, fullCompileOfFinalSourceTree: false };
report.passed = config.length === 0 && global.length === 0 && optionDiagnostics.length === 0 && targets.every(r => r.syntactic.length === 0 && r.semantic.length === 0) && forbiddenWriteAttempts === 0;
fs.writeFileSync(path.join(scratch, 'source-checker-report.json'), JSON.stringify(report, null, 2) + '\n', { flag: 'wx' });
console.log(JSON.stringify({ stage: 'checker', passed: report.passed, rootCount: report.rootCount, targets: targets.map(r => ({ path: r.sourcePath, syntactic: r.syntactic.length, semantic: r.semantic.length })), config: config.length, global: global.length, options: optionDiagnostics.length, nonTargetDiagnosticsRequested: false, forbiddenWriteAttempts }));
process.exitCode = report.passed ? 0 : 1;
