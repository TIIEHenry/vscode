  assert (I/name).is_dir() and not (I/name).is_symlink() and not os.path.lexists(ARC/name)
  wal('031-rename-'+name.replace('.','')+'-intent.json',source=str(I/name),retained=str(ARC/name),before=meta(I/name))
  os.rename(I/name,ARC/name)
  for parent in [I,ARC]:
   fd=os.open(parent,os.O_RDONLY|os.O_DIRECTORY);os.fsync(fd);os.close(fd)
  os.symlink(str(target),I/name)
  fd=os.open(I,os.O_RDONLY|os.O_DIRECTORY);os.fsync(fd);os.close(fd)
  wal('032-rename-'+name.replace('.','')+'-complete.json',retained=meta(ARC/name),newAlias=meta(I/name))
 retained=retention();durable(RES/'evidence/retention-before-ff.json',retained)
 assert (deadline-now()).total_seconds()>=120
 fixed_preflight();verify_shared()
 argv=['rtk','proxy','env','GIT_OPTIONAL_LOCKS=0','git','-C',str(I),'-c','gc.auto=0','-c','maintenance.auto=false','-c','core.fsmonitor=false','-c','core.hooksPath=/dev/null','-c','merge.autoStash=false','-c','submodule.recurse=false','merge','--ff-only','--no-autostash',F['targetHead']]
 assert not (RES/'wal/040-single-ff-invocation-before.json').exists()
 wal('040-single-ff-invocation-before.json',actualArgv=argv,invocationOrdinal=1,maxInvocations=1,beforeHead=F['currentHead'],secondsRemaining=(deadline-now()).total_seconds())
 invocations=1;run=subprocess.run(argv,capture_output=True,cwd=R)
 for name,data in [('ff.stdout.raw',run.stdout),('ff.stderr.raw',run.stderr)]:
  with (RES/'evidence'/name).open('xb') as f:f.write(data);f.flush();os.fsync(f.fileno())
 wal('041-single-ff-actual-result.json',actualArgv=argv,actualExitCode=run.returncode,ffInvocations=1,stdoutBytes=len(run.stdout),stdoutSha256=sha(run.stdout),stderrBytes=len(run.stderr),stderrSha256=sha(run.stderr))
 print(json.dumps(dict(phase='ff-completed',exitCode=run.returncode,ffInvocations=1,head=g('rev-parse','HEAD').decode().strip(),secondsRemaining=(deadline-now()).total_seconds())),flush=True)
 assert run.returncode==0,'FF failure: stop, no retry or rollback'
 assert g('rev-parse','HEAD').decode().strip()==F['targetHead'] and g('rev-parse','HEAD:src').decode().strip()==F['targetSourceTree']
 index={}
 for row in g('ls-files','--stage','-z').split(b'\0'):
  if row:
   head,path=row.split(b'\t',1);mode,oid,stage=head.split();assert stage==b'0';index[path.decode()]=(mode.decode(),oid.decode())
 checked=[]
 for raw in g('ls-tree','-r','-z',F['targetHead']).split(b'\0'):
  if not raw:continue
  head,path=raw.split(b'\t',1);mode,kind,oid=head.split();name=path.decode();p=I/name;assert index[name]==(mode.decode(),oid.decode())
  if mode==b'160000':checked.append(dict(path=name,mode=mode.decode(),gitObject=oid.decode(),gitlinkIndexIdentityExact=True));continue
  m=meta(p);assert m['exists']
  if mode==b'120000':assert p.is_symlink();b=os.readlink(p).encode()
  else:assert p.is_file() and not p.is_symlink();b=p.read_bytes();assert bool(p.stat().st_mode&0o111)==(mode==b'100755'),name
  assert hashlib.sha1(b'blob '+str(len(b)).encode()+b'\0'+b).hexdigest()==oid.decode(),name
  checked.append(dict(path=name,mode=mode.decode(),fullMode=m['fullMode'],bytes=len(b),sha256=sha(b),gitObject=oid.decode(),exact=True))
 assert len(checked)==len(index)
 durable(RES/'evidence/all-target-tracked-bytes-and-modes.json',dict(head=F['targetHead'],sourceTree=F['targetSourceTree'],rows=checked,allExact=True))
 assert sha(Path(J['ignoredFont']['path']).read_bytes())==J['ignoredFont']['sha256']
 kept=retention();verify_shared();protection('after-I-ff')
 for path in CHECK['unchangedExistingDependencyAliases']:
  expected=next(x for x in J['currentStationAliases'] if x['path']==path);m=meta(path)
  for k in ['type','fullMode','uid','gid','device','inode','size','mtimeNs','ctimeNs','symlinkTarget']:assert m[k]==expected[k],(path,k)
 assert os.readlink(I/'out')==str(RES/'writable/out') and os.readlink(I/'.build')==str(RES/'writable/build-state')
 assert os.readlink(RES/'writable/build-state/electron')=='/tmp/vscode-m01-fifth-electron-xrzlalwx/electron'
 types=json.loads((RES/'preservation/private-typings-entity-copy.json').read_bytes())
 for x in types['rows']:assert sha(Path(x['copy']).read_bytes())==x['sha256'] and Path(x['copy']).stat().st_ino!=Path(x['source']).stat().st_ino
 status=g('-c','core.fsmonitor=false','status','--porcelain=v1','-uall');assert not status
 durable(RES/'evidence/retention-after-ff.json',kept)
 wal('050-static-reservation-postcheck-complete.json',head=F['targetHead'],sourceTree=F['targetSourceTree'],ffInvocations=1,allTrackedTargetCount=len(checked),allTrackedBytesAndGitModesExact=True,trackedAndUntrackedClean=True,ignoredFontExact=True,retainedOut14852AndBuild122Exact=True,sharedSevenFrozen=True,legacy3238AndOldP443AndSourceHistoryExact=True,parentsAfter=[meta(x['path']) for x in F['necessaryParentMetadata']],gitLeavesAfter=[meta(x) for x in CHECK['completeAllowedGitLeafSet']],rootRenameCtimeChanges=kept['rootRenameCtimeChanges'],buildAuthorized=False,buildPerformed=False,afterAuthorized=False,afterPerformed=False,ready=False,remainingSeconds=(deadline-now()).total_seconds())
 print(json.dumps(dict(phase='STATIC_RESERVATION_POSTCHECK_COMPLETE',head=F['targetHead'],src=F['targetSourceTree'],ffInvocations=1,trackedTargets=len(checked),clean=True,build=False,after=False,ready=False,secondsRemaining=(deadline-now()).total_seconds())),flush=True)
except BaseException as exc:
 name='ERROR-'+now().strftime('%H%M%S%f')+'.json'
 wal(name,errorType=type(exc).__name__,error=str(exc),ffInvocations=invocations,IHead=g('rev-parse','HEAD').decode().strip(),noRollbackOrRetry=True,build=False,after=False)
 raise
