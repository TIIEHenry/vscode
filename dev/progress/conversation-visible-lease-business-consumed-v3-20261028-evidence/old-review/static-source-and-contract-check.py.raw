schema=readj(P/'package-contract.schema.json')
def validate_data(value,s,path='$'):
 errors=[]
 typ=s.get('type')
 kinds={'object':lambda x:isinstance(x,dict),'array':lambda x:isinstance(x,list),'string':lambda x:isinstance(x,str),'integer':lambda x:isinstance(x,int) and not isinstance(x,bool),'number':lambda x:isinstance(x,(int,float)) and not isinstance(x,bool),'boolean':lambda x:isinstance(x,bool),'null':lambda x:x is None}
 if typ and not kinds[typ](value):return [path+': type '+typ]
 if 'const' in s and (value!=s['const'] or type(value)!=type(s['const'])):errors.append(path+': const')
 if 'enum' in s and value not in s['enum']:errors.append(path+': enum')
 if isinstance(value,str):
  if len(value)<s.get('minLength',0):errors.append(path+': minLength')
  if 'pattern' in s and re.search(s['pattern'],value) is None:errors.append(path+': pattern')
 if isinstance(value,int) and not isinstance(value,bool) and 'minimum' in s and value<s['minimum']:errors.append(path+': minimum')
 if isinstance(value,list):
  if len(value)<s.get('minItems',0):errors.append(path+': minItems')
  if 'maxItems' in s and len(value)>s['maxItems']:errors.append(path+': maxItems')
  for i,x in enumerate(value):
   if 'items' in s:errors+=validate_data(x,s['items'],path+'['+str(i)+']')
 if isinstance(value,dict):
  for k in s.get('required',[]):
   if k not in value:errors.append(path+'.'+k+': required')
  props=s.get('properties',{})
  for k,x in value.items():
   if k in props:errors+=validate_data(x,props[k],path+'.'+k)
   elif s.get('additionalProperties') is False:errors.append(path+'.'+k+': additionalProperties')
   elif isinstance(s.get('additionalProperties'),dict):errors+=validate_data(x,s['additionalProperties'],path+'.'+k)
 return errors
