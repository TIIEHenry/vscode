// Prepared only: no type checker is invoked until authorize succeeds.
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';
import { installIsolation } from './fs-isolation.mjs';
import { authorize, repo, scratch, check, sha, immutableInputs } from './binding.mjs';
const { manifest } = authorize('checker');
const isolation = installIsolation({ repo, scratch, stage: 'checker', manifest });
const require = createRequire(path.join(repo, 'package.json'));
const ts = require('typescript');
const project = path.join(repo, 'src/tsconfig.json');
const read = ts.readConfigFile(project, ts.sys.readFile);
const parsed = ts.parseJsonConfigFileContent(read.config ?? {}, ts.sys, path.dirname(project), undefined, project);
const configErrors = [...(read.error ? [read.error] : []), ...parsed.errors];
const options = { ...parsed.options, noEmit: true, incremental: false, composite: false, tsBuildInfoFile: undefined };
const inputs = immutableInputs(manifest);
const overlay = new Map(inputs.map(input => [input.canonicalAbsolute, input]));
const canonical = file => path.resolve(file);
const host = ts.createCompilerHost(options, true);
const originalReadFile = host.readFile.bind(host), originalGetSourceFile = host.getSourceFile.bind(host);
const overlayReads = { readFile: {}, getSourceFile: {} };
host.readFile = file => {
 const key = canonical(file), input = overlay.get(key);
 if (!input) return originalReadFile(file);
 overlayReads.readFile[key] = (overlayReads.readFile[key] ?? 0) + 1;
 check(sha(fs.readFileSync(input.row.inputCopyPath)) === input.row.sourceSha256, 'Overlay input changed before readFile');
 return input.text;
};
host.getSourceFile = (file, languageVersion, onError, shouldCreateNewSourceFile) => {
 const key = canonical(file), input = overlay.get(key);
 if (!input) return originalGetSourceFile(file, languageVersion, onError, shouldCreateNewSourceFile);
 overlayReads.getSourceFile[key] = (overlayReads.getSourceFile[key] ?? 0) + 1;
 const text = host.readFile(key);
 check(text === input.text, 'getSourceFile did not use immutable canonical overlay');
 return ts.createSourceFile(key, text, languageVersion, true, ts.ScriptKind.TS);
};
check(inputs.length === 2 && inputs.every(input => parsed.fileNames.some(file => canonical(file) === input.canonicalAbsolute)), 'Targets absent from full current project roots');
let forbiddenWriteAttempts = 0;
host.writeFile = () => { forbiddenWriteAttempts++; throw Error('FORBIDDEN: noEmit checker attempted an artifact/cache/tsbuildinfo write'); };
const program = ts.createProgram({ rootNames: parsed.fileNames, options, host, configFileParsingDiagnostics: configErrors });
const format = d => ({ code: d.code, category: ts.DiagnosticCategory[d.category], message: ts.flattenDiagnosticMessageText(d.messageText, '\n'), file: d.file?.fileName ?? null, start: d.start ?? null, length: d.length ?? null, position: d.file && d.start !== undefined ? d.file.getLineAndCharacterOfPosition(d.start) : null, relatedInformation: d.relatedInformation?.map(v => ({ code: v.code, file: v.file?.fileName ?? null, start: v.start ?? null, message: ts.flattenDiagnosticMessageText(v.messageText, '\n') })) ?? [] });
const config = program.getConfigFileParsingDiagnostics(), global = program.getGlobalDiagnostics(), optionDiagnostics = program.getOptionsDiagnostics();
const targets = inputs.map(({ row, canonicalAbsolute, bytes, text }) => {
 const file = program.getSourceFile(canonicalAbsolute);
 check(file && canonical(file.fileName) === canonicalAbsolute && file.text === text && Buffer.from(file.text).equals(bytes) && sha(Buffer.from(file.text)) === row.sourceSha256 && overlayReads.getSourceFile[canonicalAbsolute] > 0 && overlayReads.readFile[canonicalAbsolute] > 0, 'Actual Program target text differs from immutable input: ' + row.sourcePath);
 const semantic = program.getSemanticDiagnostics(file);
 return { ...row, canonicalAbsolute, actualProgramBytes: Buffer.byteLength(file.text), actualProgramSha256: sha(Buffer.from(file.text)), actualProgramTextEqualsImmutableCopy: true, utf8RoundTripExact: true, syntactic: program.getSyntacticDiagnostics(file).map(format), semantic: semantic.map(format) };
});
const report = { capturedAtUtc: new Date().toISOString(), project, mode: manifest.mode, perInputRefsAreDistinctFromWorkspaceHead: true, overlayReads, sourceTree: manifest.sourceTree, expectedHead: manifest.expectedHead, typescriptVersion: ts.version, originalCompilerOptions: parsed.options, effectiveCompilerOptions: options, rootCount: parsed.fileNames.length, rootNames: parsed.fileNames, programSourceFileCount: program.getSourceFiles().length, targets, configDiagnostics: config.map(format), globalDiagnostics: global.map(format), optionDiagnostics: optionDiagnostics.map(format), nonTargetSyntacticDiagnosticsRequested: false, nonTargetSemanticDiagnosticsRequested: false, filteringPolicy: 'Full actual src project and ambient context; config/options/global and two immutable canonical targets syntactic/semantic diagnostics gate. No non-target syntactic or semantic diagnostics requested; no full-project semantic-clean claim.', noEmit: true, emitInvoked: false, incremental: false, composite: false, tsBuildInfoFile: null, forbiddenWriteAttempts, fullCompileOfFinalSourceTree: false };
report.passed = config.length === 0 && global.length === 0 && optionDiagnostics.length === 0 && targets.every(r => r.syntactic.length === 0 && r.semantic.length === 0) && forbiddenWriteAttempts === 0;
fs.writeFileSync(path.join(scratch, 'source-checker-report.json'), JSON.stringify(report, null, 2) + '\n', { flag: 'wx' });
console.log(JSON.stringify({ stage: 'checker', passed: report.passed, rootCount: report.rootCount, targets: targets.map(r => ({ path: r.sourcePath, syntactic: r.syntactic.length, semantic: r.semantic.length })), config: config.length, global: global.length, options: optionDiagnostics.length, nonTargetDiagnosticsRequested: false, forbiddenWriteAttempts }));
isolation.assertHealthy();
process.exitCode = report.passed ? 0 : 1;
