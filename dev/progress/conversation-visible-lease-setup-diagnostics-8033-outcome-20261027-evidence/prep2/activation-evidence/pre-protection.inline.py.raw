 s=f.stat();return dict(path=f.relative_to(base).as_posix(),bytes=s.st_size,sha256=sha(f.read_bytes()),mode=stat.S_IMODE(s.st_mode),mtimeNs=s.st_mtime_ns,ctimeNs=s.st_ctime_ns)
